// ═══════════════════════════════════════════════════════════════════════════════
//  TV-1M-winrate-mode4_(09月20日; 14:49)  ·  模式 4 (高勝率時段) 專用副圖 · 配合主策略 TV-1M-macd-hist,cross&rsi 一起掛
//  模式 4 只有一個條件: 時間落在高勝率時段 10:00-10:20 / 10:30-11:00 / 11:50-12:30 / 13:30-14:00 (紐約時間) → 輸出 1 = 可以買入; 否則 0
//  不考慮當天高開或低開 (本版已移除); 時段在 ② 可改, 必須與主策略 ④e 的 zoneSess 一致
//  顯示: 階梯線 1 (綠底) / 0 (灰); 每個時段開始標「可買」; 右上統計窗內交易日與可買 K 數; 這支不下單, 真正的閘門在主策略 ④e (買入需四模式同時)
//  四處必須一致: 標題 = shorttitle = 檔名 = TradingView 腳本名稱 (結尾的 ")" 不可漏); 本檔共 86 行, 最後一行是 END OF FILE
// ═══════════════════════════════════════════════════════════════════════════════
//@version=6
indicator("TV-1M-winrate-mode4_(09月20日; 14:49)", shorttitle="TV-1M-winrate-mode4_(09月20日; 14:49)", overlay = false, max_labels_count = 500)

// ─────────────────────────── ① 回測期間 / 時段 (與主策略對齊) ───────────────────────────
gBT       = "① 回測期間 / 時段 (與主策略對齊)"
winMode   = input.string("最近 N 天 (日曆)", "回測期間方式", options = ["最近 N 個交易日", "最近 N 天 (日曆)", "指定日期"], group = gBT, display = display.none)
tradDays  = input.int(21, "方式 A · 最近 N 個交易日", minval = 1, maxval = 250, group = gBT, display = display.none)
lookbackD = input.int(30, "方式 B · 最近 N 天 (日曆)", minval = 1, group = gBT, display = display.none)
startIn   = input.time(timestamp("19 Aug 2026 00:00 -0400"), "方式 C · 開始", group = gBT, display = display.none)
endIn     = input.time(timestamp("19 Sep 2026 23:59 -0400"), "方式 C · 結束", group = gBT, display = display.none)
mktPreset = input.string("美股", "市場預設", options = ["美股", "港股", "自訂"], group = gBT, display = display.none)
sessCust  = input.session("0930-1600", "自訂: 交易時段", group = gBT, display = display.none)
tzCust    = input.string("America/New_York", "自訂: 時區", group = gBT, display = display.none)
tzX       = syminfo.timezone
lastDay0  = timestamp(tzX, year(last_bar_time, tzX), month(last_bar_time, tzX), dayofmonth(last_bar_time, tzX), 0, 0, 0)
var int tdStart = na
if na(tdStart)
    ddT = lastDay0
    cntD = 1
    guardD = 0
    while cntD < tradDays and guardD < 400
        ddT -= 86400000
        guardD += 1
        dwD = dayofweek(ddT + 43200000, tzX)
        if dwD != dayofweek.saturday and dwD != dayofweek.sunday
            cntD += 1
    tdStart := ddT
btStart  = winMode == "最近 N 個交易日" ? tdStart : winMode == "最近 N 天 (日曆)" ? timenow - lookbackD * 86400000 : startIn
btEnd    = winMode == "指定日期" ? endIn : timenow
inWindow = time >= btStart and time <= btEnd
sessStr  = mktPreset == "港股" ? "0930-1200,1300-1600" : mktPreset == "美股" ? "0930-1600" : sessCust
tzStr    = mktPreset == "港股" ? "Asia/Hong_Kong" : mktPreset == "美股" ? "America/New_York" : tzCust
isIntra  = timeframe.isintraday
inSess   = not isIntra or not na(time(timeframe.period, sessStr, tzStr))
newSess  = inSess and not inSess[1]

// ─────────────────────────── ② 模式 4 · 高勝率時段 — 唯一條件; 不考慮當天高開或低開 ───────────────────────────
gR4      = "② 模式 4 · 高勝率時段 (唯一條件; 與主策略 ④e 保持一致)"
zoneSess = input.session("1000-1020,1030-1100,1150-1230,1330-1400", "高勝率時段 (只在這些時段可以買入; 紐約時間, 逗號分隔)", group = gR4, display = display.none)
inZone   = isIntra and not na(time(timeframe.period, zoneSess, tzStr))
gateOn   = inSess and inZone                      // 模式 4 輸出: 1 = 可以買入, 0 = 不可

// ─────────────────────────── ③ 顯示: 階梯線 1 = 可買 (綠底) / 0 = 不可 (灰) ───────────────────────────
cOn   = color.rgb(0, 130, 60)
cOff  = color.rgb(150, 150, 150)
gateV = not inSess ? na : gateOn ? 1.0 : 0.0
plot(gateV, "模式4 (1 可買 / 0 不可)", style = plot.style_stepline, linewidth = 3, color = gateOn ? cOn : cOff, display = display.pane + display.price_scale)
bgcolor(not inSess ? na : gateOn ? color.new(cOn, 85) : color.new(cOff, 94), title = "時段底色")
bgcolor(inWindow ? color.new(color.blue, 96) : na, title = "回測期間底色")
hline(1.0, "可買", color = color.new(cOn, 60), linestyle = hline.style_dotted)
hline(0.0, "不可", color = color.new(cOff, 60), linestyle = hline.style_dotted)
// 每個時段開始那一根標一下 (只在回測窗內)
if inWindow and gateOn and not gateOn[1]
    label.new(bar_index, 1.05, "可買", style = label.style_label_down, color = color.new(cOn, 30), textcolor = color.white, size = size.tiny)
var label lbG = na
if barstate.islast
    label.delete(lbG)
    lbG := label.new(chart.left_visible_bar_time, 1.0, "模式4 · 高勝率時段: 綠 = 可買入 (10:00-10:20 / 10:30-11:00 / 11:50-12:30 / 13:30-14:00 NY), 灰 = 不可", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(cOn, 30), textcolor = color.white, size = size.tiny)

// ─────────────────────────── ④ 統計表 (靠右) ───────────────────────────
var int nDays  = 0
var int nBarOn = 0
if newSess and inWindow
    nDays += 1
if inWindow and gateOn
    nBarOn += 1
var table tb = table.new(position.top_right, 2, 4, border_width = 1, frame_width = 1, frame_color = color.gray)
if barstate.islast
    table.clear(tb, 0, 0, 1, 3)
    hBg = color.new(color.gray, 70)
    table.cell(tb, 0, 0, "模式 4 · 高勝率時段", text_size = size.tiny, text_color = color.white, bgcolor = cOn)
    table.cell(tb, 1, 0, gateOn ? "現在可買" : "現在不可", text_size = size.tiny, text_color = color.white, bgcolor = gateOn ? cOn : cOff)
    table.cell(tb, 0, 1, "時段 (NY)", text_size = size.tiny, bgcolor = hBg)
    table.cell(tb, 1, 1, zoneSess, text_size = size.tiny)
    table.cell(tb, 0, 2, "窗內交易日", text_size = size.tiny, bgcolor = hBg)
    table.cell(tb, 1, 2, str.tostring(nDays), text_size = size.tiny)
    table.cell(tb, 0, 3, "窗內可買 K 數", text_size = size.tiny, bgcolor = hBg)
    table.cell(tb, 1, 3, str.tostring(nBarOn) + " (每日 " + str.tostring(nDays > 0 ? nBarOn / nDays : 0.0, "#.#") + ")", text_size = size.tiny)
// ═══ END OF FILE ═══ TV-1M-winrate-mode4_(09月20日; 14:49) · 全檔共 86 行 · 看不到這一行 = 貼上的內容被截斷, 請用「貼上工具」網頁的【複製全部程式碼】 ═══
