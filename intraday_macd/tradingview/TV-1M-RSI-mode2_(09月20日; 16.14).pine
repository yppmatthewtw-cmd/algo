// ═══════════════════════════════════════════════════════════════════════════════
//  TV-1M-RSI-mode2_(09月20日; 16:14)  ·  模式 2 (cRSI 轉勢 + 動態上下界) 專用副圖 · 配合主策略 TV-1M-dashboard_(mode 1-4) 一起掛
//  參考 whentotrade / Lars von Thienen 的 cRSI v4: domcycle 20 → RSI 長度 10, vibration 10 相位補償平滑成 cRSI, 上下界 = 最近 40 根 cRSI 的第 10 / 90 百分位 (與原版逐格掃描等價, 可切回原版)
//  可買 = cRSI 梯度由 ≤0 轉為 >0 且 轉勢的谷底到達或低於下界; 可賣 = 相反 (梯度由 ≥0 轉為 <0 且 峰頂到達或高於上界); 模式 2 只輸出這兩種; 收盤確認, 不重繪
//  舊的 RSI(14) 固定 / 百分位門檻、S05 上穿 55 賣訊、HL 結構過濾已全部刪除
//  顯示: 深棕粗線 cRSI · 綠/紅細線 = 下界/上界 · ▲ 淺藍 = 可買 · ▼ 淺紅 = 可賣 · 灰小三角 = 未到界的轉勢 (對照用, ③ 可關)
//  ② 的 domcycle / vibration / leveling / 上下界算法 / 到界回看根數 必須與主策略 ④c 一致; 這支不下單; plot 的 title 必須是常數字串
//  四處必須一致: 標題 = shorttitle = 檔名 = TradingView 腳本名稱 (結尾的 ")" 不可漏); 本檔共 174 行, 最後一行是 END OF FILE
// ═══════════════════════════════════════════════════════════════════════════════
//@version=6
indicator("TV-1M-RSI-mode2_(09月20日; 16:14)", shorttitle="TV-1M-RSI-mode2_(09月20日; 16:14)", overlay = false, max_labels_count = 500, max_lines_count = 500)

// ─────────────────────────── ① 回測期間 (與主策略同一套設定, 只用來畫底色) ───────────────────────────
gBT        = "① 回測期間 (與主策略對齊)"
winMode    = input.string("最近 N 天 (日曆)", "回測期間方式 (三選一; 預設一個月)", options = ["最近 N 個交易日", "最近 N 天 (日曆)", "指定日期"], group = gBT, display = display.none)
tradDays   = input.int(21, "方式 A · 最近 N 個交易日", minval = 1, maxval = 250, group = gBT, display = display.none)
lookbackD  = input.int(30, "方式 B · 最近 N 天 (日曆; 30 = 一個月)", minval = 1, group = gBT, display = display.none)
startIn    = input.time(timestamp("19 Aug 2026 00:00 -0400"), "方式 C · 開始日期 (含)", group = gBT, display = display.none)
endIn      = input.time(timestamp("19 Sep 2026 23:59 -0400"), "方式 C · 結束日期 (含)", group = gBT, display = display.none)
tzX        = syminfo.timezone
lastDay0   = timestamp(tzX, year(last_bar_time, tzX), month(last_bar_time, tzX), dayofmonth(last_bar_time, tzX), 0, 0, 0)
var int tdStart = na
if na(tdStart)
    ddT   = lastDay0
    cntD  = 1
    guardD = 0
    while cntD < tradDays and guardD < 400
        ddT    -= 86400000
        guardD += 1
        dwD = dayofweek(ddT + 43200000, tzX)
        if dwD != dayofweek.saturday and dwD != dayofweek.sunday
            cntD += 1
    tdStart := ddT
btStart    = winMode == "最近 N 個交易日" ? tdStart : winMode == "最近 N 天 (日曆)" ? timenow - lookbackD * 86400000 : startIn
btEnd      = winMode == "指定日期" ? endIn : timenow
inWindow   = time >= btStart and time <= btEnd

// ─────────────────────────── ② 模式 2 · cRSI 轉勢 + 動態上下界 (參考 whentotrade / Lars von Thienen · cRSI v4) — 與主策略 ④c 的設定必須一致 ───────────────────────────
gR2        = "② 模式 2 · cRSI 轉勢 + 動態上下界 (與主策略 ④c 保持一致)"
domCycle   = input.int(20, "主週期 domcycle (cRSI v4 預設 20; RSI 長度 = 主週期 ÷ 2, 記憶 = 主週期 × 2)", minval = 4, maxval = 200, group = gR2, tooltip = "務必與主策略 ④c 的同名設定一致, 否則兩個副圖顯示的訊號會對不上。", display = display.none)
vibration  = input.int(10, "vibration (cRSI v4 預設 10)", minval = 1, maxval = 50, group = gR2, display = display.none)
leveling   = input.float(10, "leveling (%): 下界 = 第 leveling 百分位, 上界 = 第 100-leveling 百分位", minval = 1, maxval = 49, step = 1, group = gR2, display = display.none)
bandMd     = input.string("百分位 (與原版逐格掃描結果幾乎相同, 快)", "上下界算法", options = ["百分位 (與原版逐格掃描結果幾乎相同, 快)", "原版 cRSI v4 逐格掃描 (101 格 × 記憶根數, 慢)"], group = gR2, display = display.none)
m2Reach    = input.int(1, "轉勢前幾根內曾到達 / 超過該界才算 (1 = 轉勢那根的極值本身要在界外)", minval = 1, maxval = 10, group = gR2, display = display.none)
// cRSI v4 核心 — 所有 ta.* 在全域無條件計算 (Pine v6 的 and / or 是短路求值)
cycleLen   = math.max(2, math.floor(domCycle / 2))
cycMem     = domCycle * 2
torque     = 2.0 / (vibration + 1)
phaseLag   = math.max(0, math.floor((vibration - 1) / 2))
cUpM       = ta.rma(math.max(ta.change(close), 0), cycleLen)
cDnM       = ta.rma(-math.min(ta.change(close), 0), cycleLen)
rsiC       = cDnM == 0 ? 100 : cUpM == 0 ? 0 : 100 - 100 / (1 + cUpM / cDnM)
var float crsi = 0.0
crsi      := torque * (2 * rsiC - rsiC[phaseLag]) + (1 - torque) * nz(crsi[1])
crsiPLo    = ta.percentile_linear_interpolation(crsi, cycMem, leveling)
crsiPHi    = ta.percentile_linear_interpolation(crsi, cycMem, 100 - leveling)
lmax       = ta.highest(crsi, cycMem)
lmin       = ta.lowest(crsi, cycMem)
db         = nz(crsiPLo, 0.0)
ub         = nz(crsiPHi, 100.0)
if bandMd == "原版 cRSI v4 逐格掃描 (101 格 × 記憶根數, 慢)" and bar_index >= cycMem
    mstep = (lmax - lmin) / 100
    aperc = leveling / 100
    dbF   = 0.0
    for st = 0 to 100
        tv = lmin + mstep * st
        below = 0
        for m = 0 to cycMem - 1
            below += crsi[m] < tv ? 1 : 0
        if below / cycMem >= aperc
            dbF := tv
            break
    ubF   = 0.0
    for st = 0 to 100
        tv = lmax - mstep * st
        above = 0
        for m = 0 to cycMem - 1
            above += crsi[m] >= tv ? 1 : 0
        if above / cycMem >= aperc
            ubF := tv
            break
    db := dbF
    ub := ubF
// 買區 / 賣區 (單根事件; 模式 2 的輸出只有「可買」或「可賣」)
turnUp     = crsi > crsi[1] and crsi[1] <= crsi[2]        // 梯度由 ≤0 轉為 >0 (谷底在前一根, 本根收盤確認, 不重繪)
turnDn     = crsi < crsi[1] and crsi[1] >= crsi[2]        // 梯度由 ≥0 轉為 <0 (峰頂在前一根)
sinceLo    = ta.barssince(crsi <= db)
sinceHi    = ta.barssince(crsi >= ub)
reachLo    = nz(sinceLo[1], 99999) < m2Reach
reachHi    = nz(sinceHi[1], 99999) < m2Reach
m2BuyRaw   = turnUp
m2SellRaw  = turnDn
m2Buy      = turnUp and reachLo                           // 進入買區 = 可買
m2Sell     = turnDn and reachHi                           // 進入賣區 = 可賣
var string m2Zone = "-"
m2Zone    := m2Buy ? "可買" : m2Sell ? "可賣" : m2Zone

// ─────────────────────────── ③ 顯示 ───────────────────────────
gDS        = "③ 顯示"
lwRsi      = input.int(3, "cRSI 線粗細", minval = 1, maxval = 6, group = gDS, display = display.none)
showRaw    = input.bool(true, "顯示未到界的轉勢 (灰色小三角, 只供對照)", group = gDS, display = display.none)
showVL     = input.bool(true, "每個可買 / 可賣訊號畫一條淺灰幼直線 (買 點線 / 賣 虛線)", group = gDS, display = display.none)
vlTransp   = input.int(78, "直線淡化 (透明度 %; 越大越淡)", minval = 30, maxval = 95, step = 2, group = gDS, display = display.none)
showBg     = input.bool(true, "回測期間底色", group = gDS, display = display.none)
showTbl    = input.bool(true, "右上顯示訊號統計", group = gDS, display = display.none)
tblPos     = input.string("右上", "統計表位置", options = ["右上", "右下"], group = gDS, display = display.none)

cBrown     = color.rgb(92, 51, 23)          // 模式 2: 深棕 (粗)
cBuyTri    = color.rgb(120, 180, 255)       // 可買 ▲ 淺藍
cSellTri   = color.rgb(255, 120, 120)       // 可賣 ▼ 淺紅

plot(crsi, "cRSI", color = cBrown, linewidth = lwRsi, display = display.pane + display.price_scale)
pLo   = plot(db, "下界 (lower band)", color = color.new(color.green, 40), linewidth = 1, display = display.pane)
pHi   = plot(ub, "上界 (upper band)", color = color.new(color.red, 40), linewidth = 1, display = display.pane)
p0    = plot(0, "0", color = color.new(color.gray, 90), display = display.pane)
p100  = plot(100, "100", color = color.new(color.gray, 90), display = display.pane)
fill(p0, pLo, color = color.new(color.green, 92), title = "下界以下 (買區候選)")
fill(pHi, p100, color = color.new(color.red, 92), title = "上界以上 (賣區候選)")
bgcolor(showBg and inWindow ? color.new(color.blue, 94) : na, title = "回測期間底色")

// 訊號直接標在 cRSI 曲線上 (label, 最多保留最近 500 個): ▲ 淺藍 = 可買 (到下界後轉勢向上); ▼ 淺紅 = 可賣 (到上界後轉勢向下); 灰小三角 = 未到界的轉勢
if m2Buy and inWindow
    label.new(bar_index, crsi, "", style = label.style_triangleup,   color = cBuyTri,  size = size.small, yloc = yloc.price)
if m2Sell and inWindow
    label.new(bar_index, crsi, "", style = label.style_triangledown, color = cSellTri, size = size.small, yloc = yloc.price)
if showRaw and m2BuyRaw and not m2Buy and inWindow
    label.new(bar_index, crsi, "", style = label.style_triangleup,   color = color.new(color.gray, 55), size = size.tiny, yloc = yloc.price)
if showRaw and m2SellRaw and not m2Sell and inWindow
    label.new(bar_index, crsi, "", style = label.style_triangledown, color = color.new(color.gray, 55), size = size.tiny, yloc = yloc.price)

// 淺灰幼直線: 與主策略同一個視覺語言 (買 點線 / 賣 虛線), 本副圖內貫通上下
vlCol = color.new(color.gray, vlTransp)
if showVL and inWindow and m2Buy
    line.new(bar_index, 0.0, bar_index, 100.0, extend = extend.both, color = vlCol, width = 1, style = line.style_dotted)
if showVL and inWindow and m2Sell
    line.new(bar_index, 0.0, bar_index, 100.0, extend = extend.both, color = vlCol, width = 1, style = line.style_dashed)

// 左側線名標籤 (貼在可見範圍最左那根 K 的 cRSI 值上)
var float yRsi = na
if time >= chart.left_visible_bar_time and na(yRsi)
    yRsi := crsi
var label lbR = na
if barstate.islast
    label.delete(lbR)
    lbR := label.new(chart.left_visible_bar_time, nz(yRsi, crsi), "模式2 · cRSI(" + str.tostring(domCycle) + ") ▲可買=到下界後轉勢向上 ▼可賣=到上界後轉勢向下 · 灰=未到界的轉勢", xloc = xloc.bar_time, style = label.style_label_left, color = cBrown, textcolor = color.white, size = size.tiny)

// 訊號統計 (靠右, 與主策略的表格同側)
var int nB = 0
var int nBr = 0
var int nS = 0
var int nSr = 0
if inWindow
    nB  += m2Buy ? 1 : 0
    nBr += m2BuyRaw ? 1 : 0
    nS  += m2Sell ? 1 : 0
    nSr += m2SellRaw ? 1 : 0
posT = tblPos == "右下" ? position.bottom_right : position.top_right
var table tb = table.new(posT, 2, 6, border_width = 1, frame_width = 1, frame_color = color.gray)
if barstate.islast and showTbl
    table.clear(tb, 0, 0, 1, 5)
    hBg = color.new(color.gray, 70)
    table.cell(tb, 0, 0, "模式 2 · cRSI 轉勢 + 上下界", text_size = size.tiny, text_color = color.white, bgcolor = cBrown)
    table.cell(tb, 1, 0, "cRSI " + str.tostring(crsi, "#.#") + " · 現況 " + m2Zone, text_size = size.tiny, text_color = color.white, bgcolor = cBrown)
    table.cell(tb, 0, 1, "下界 / 上界 (L" + str.tostring(leveling, "#") + "%, 記憶 " + str.tostring(cycMem) + " 根)", text_size = size.tiny, bgcolor = hBg)
    table.cell(tb, 1, 1, str.tostring(db, "#.#") + " / " + str.tostring(ub, "#.#"), text_size = size.tiny)
    table.cell(tb, 0, 2, "可買: 轉勢向上 → 到下界才算", text_size = size.tiny, bgcolor = hBg)
    table.cell(tb, 1, 2, str.tostring(nBr) + " → " + str.tostring(nB), text_size = size.tiny, text_color = color.blue)
    table.cell(tb, 0, 3, "可賣: 轉勢向下 → 到上界才算", text_size = size.tiny, bgcolor = hBg)
    table.cell(tb, 1, 3, str.tostring(nSr) + " → " + str.tostring(nS), text_size = size.tiny, text_color = color.red)
    table.cell(tb, 0, 4, "參數 (需與主策略 ④c 一致)", text_size = size.tiny, bgcolor = hBg)
    table.cell(tb, 1, 4, "domcycle " + str.tostring(domCycle) + " · vibration " + str.tostring(vibration) + " · 到界回看 " + str.tostring(m2Reach) + " 根", text_size = size.tiny)
    table.cell(tb, 0, 5, "窗口", text_size = size.tiny, bgcolor = hBg)
    table.cell(tb, 1, 5, winMode == "最近 N 個交易日" ? str.tostring(tradDays) + " 交易日" : winMode == "最近 N 天 (日曆)" ? str.tostring(lookbackD) + " 天" : "指定日期", text_size = size.tiny)
// ═══ END OF FILE ═══ TV-1M-RSI-mode2_(09月20日; 16:14) · 全檔共 174 行 · 看不到這一行 = 貼上的內容被截斷, 請用「貼上工具」網頁的【複製全部程式碼】 ═══
