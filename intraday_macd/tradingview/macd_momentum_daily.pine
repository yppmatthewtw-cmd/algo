// ═══════════════════════════════════════════════════════════════════════════════
//  MACD 動能蓄積交叉策略 · 【日線 DAILY 回測版】 · TradingView Pine Script v6
//
//  規則 (與 1 分鐘版同一套邏輯, 只是 K 線改為日線):
//   買點 = 負動能段「儲夠」(藍框紅柱群) 後, 收盤確認 DIF 上穿 DEA (藍直線) → 下一根開盤買入
//   賣點 = 正動能段「儲夠」(橙框綠柱群) 後, 收盤確認 DIF 下穿 DEA (紅直線) → 下一根開盤賣出
//   「儲夠」= 同號柱段 連續根數 ≥ minBars 且 面積 Σ|hist|/close% ≥ minArea 且 深度 max|hist|/close% ≥ minDepth
//   動能不足的交叉一律忽略; 長倉 only
//
//  本版已設定:
//   ① 本金 100,000 (initial_capital)
//   ② 回測期間 = 最近 365 天 (可改為指定日期區間)
//   ③ 圖上報表: 期內交易次數 / 每筆 P&L($ 與 %) / 整個期間 Total P&L
//
//  ※ 日線上沒有「收市前平倉」「午休時段」的概念 → 本版自動繞過盤中時段邏輯 (可持倉過夜)
//  ※ 日線的柱高 (|hist|/close) 比 1 分鐘大一個數量級 → 預設用「自動百分位門檻」, 換標的免手調
//  ※ TradingView 的 MACD 柱 = DIF−DEA (牛牛/Webull 顯示 2×), 門檻以 1× 定義
//
//  使用: 圖表週期切 【D 日線】 → Pine Editor 貼上 → Add to chart → 看 Strategy Tester
// ═══════════════════════════════════════════════════════════════════════════════
//@version=6
strategy("MACD動能蓄積交叉 · 日線回測", shorttitle="MACD-Momentum-D", overlay=false,
     initial_capital       = 100000,
     default_qty_type      = strategy.percent_of_equity, default_qty_value = 100,
     commission_type       = strategy.commission.percent, commission_value = 0.03,
     slippage              = 1,
     process_orders_on_close = false, calc_on_every_tick = false, pyramiding = 0,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ─────────────────────────── ① 回測期間 (預設最近一年) ───────────────────────────
gBT        = "① 回測期間"
useRolling = input.bool(true,  "用「最近 N 天」(取消勾選則用下方指定日期)", group = gBT)
lookbackD  = input.int(365,    "回測天數 (365 = 一年)", minval = 5, group = gBT)
startIn    = input.time(timestamp("01 Jan 2025 00:00 +0800"), "開始日期", group = gBT)
endIn      = input.time(timestamp("31 Dec 2025 23:59 +0800"), "結束日期", group = gBT)
btStart    = useRolling ? timenow - lookbackD * 86400000 : startIn
btEnd      = useRolling ? timenow : endIn
inWindow   = time >= btStart and time <= btEnd

// ─────────────────────────── ② 資金 / 下單金額 ───────────────────────────
gSZ       = "② 資金"
sizeMode  = input.string("全部本金", "每筆下單金額", options = ["全部本金", "固定金額", "固定股數"], group = gSZ)
fixedCash = input.float(100000, "固定金額", step = 1000, group = gSZ)
fixedQty  = input.float(1000,   "固定股數", step = 100,  group = gSZ)
// ※ 本金 100,000 寫在 strategy() 的 initial_capital; 亦可在 設定→Properties→Initial capital 改

// ─────────────────────────── ③ MACD ───────────────────────────
gM      = "③ MACD"
fastLen = input.int(12, "快線 EMA", minval = 1, group = gM)
slowLen = input.int(26, "慢線 EMA", minval = 1, group = gM)
sigLen  = input.int(9,  "訊號線 (移動平均週期)", minval = 1, group = gM)

[dif, dea, hist] = ta.macd(close, fastLen, slowLen, sigLen)
histPct = hist / close * 100.0
sgn     = hist > 0 ? 1 : hist < 0 ? -1 : 0

// ─────────────────────────── ④ 動能蓄積門檻 ───────────────────────────
gTH        = "④ 動能蓄積門檻"
thMode     = input.string("自動(百分位)", "門檻模式", options = ["自動(百分位)", "手動"], group = gTH,
     tooltip = "自動: 以近N根柱高分佈自動定門檻, 換週期/換標的免手調。手動: 自己填死數。")
minBars    = input.int(3, "動能段最少連續根數", minval = 1, group = gTH)
pctLen     = input.int(250, "自動模式取樣根數", minval = 30, group = gTH)
depthPctl  = input.float(60, "自動: 深度門檻取第幾百分位", minval = 1, maxval = 99, step = 5, group = gTH)
areaFactor = input.float(0.6, "自動: 面積係數 (面積門檻 = 深度 × 根數 × 係數)", step = 0.1, group = gTH)
minDepthIn = input.float(0.35, "手動: 深度門檻 max|hist|/close (%)", step = 0.05, group = gTH)
minAreaIn  = input.float(1.20, "手動: 面積門檻 Σ|hist|/close (%·根)", step = 0.1, group = gTH)

autoDepth = ta.percentile_linear_interpolation(math.abs(histPct), pctLen, depthPctl)
minDepth  = thMode == "手動" ? minDepthIn : autoDepth
minArea   = thMode == "手動" ? minAreaIn  : autoDepth * minBars * areaFactor

// ─────────────────────────── ⑤ 同號柱段統計 (只用已完成K, 無前視) ───────────────────────────
var int   curSign  = 0
var int   curBars  = 0
var float curArea  = 0.0
var float curDepth = 0.0
var int   curStart = na

crossUp = ta.crossover(dif, dea)
crossDn = ta.crossunder(dif, dea)
// 交叉發生在本K → 「剛結束的段」= 上一根為止的統計 (先評估, 後更新)
prevOK  = curBars >= minBars and curArea >= minArea and curDepth >= minDepth
negOK   = curSign == -1 and prevOK
posOK   = curSign ==  1 and prevOK
buySig  = crossUp and negOK
sellSig = crossDn and posOK

// 合格段畫框 + 交叉畫直線 (只在回測窗內畫, 避免物件超上限)
if buySig and inWindow
    box.new(curStart, 0.0, bar_index - 1, -curDepth * close / 100.0 * 1.15,
         border_color = color.new(color.aqua, 0), bgcolor = color.new(color.aqua, 88), border_width = 2)
    line.new(bar_index, hist, bar_index, 0.0, extend = extend.both, color = color.new(color.aqua, 0), width = 2)
if sellSig and inWindow
    box.new(curStart, 0.0, bar_index - 1, curDepth * close / 100.0 * 1.15,
         border_color = color.new(color.orange, 0), bgcolor = color.new(color.orange, 88), border_width = 2)
    line.new(bar_index, hist, bar_index, 0.0, extend = extend.both, color = color.new(color.red, 0), width = 2)

// 更新段統計
if sgn != 0 and sgn != curSign
    curSign  := sgn
    curBars  := 1
    curArea  := math.abs(histPct)
    curDepth := math.abs(histPct)
    curStart := bar_index
else if sgn != 0
    curBars  += 1
    curArea  += math.abs(histPct)
    curDepth := math.max(curDepth, math.abs(histPct))

// ─────────────────────────── ⑥ 盤中時段 (日線自動繞過) ───────────────────────────
gS      = "⑤ 盤中時段 (只在分鐘圖生效, 日線自動忽略)"
sessStr = input.session("0930-1200,1300-1600", "交易時段", group = gS)
tzStr   = input.string("Asia/Hong_Kong", "時區", group = gS)
eodSess = input.session("1558-1600", "強制平倉時段", group = gS)
isIntra = timeframe.isintraday
inSess  = not isIntra or not na(time(timeframe.period, sessStr, tzStr))
eodBar  = isIntra and not na(time(timeframe.period, eodSess, tzStr))

// ─────────────────────────── ⑦ 風控 ───────────────────────────
gR      = "⑥ 風控"
useStop = input.bool(false, "啟用固定止損 (原題不設)", group = gR)
stopPct = input.float(5.0, "止損 %", step = 0.5, group = gR)

// ─────────────────────────── ⑧ 下單 ───────────────────────────
qty     = sizeMode == "全部本金" ? strategy.equity / close : sizeMode == "固定金額" ? fixedCash / close : fixedQty
entryOK = inWindow and inSess and not eodBar

if buySig and entryOK and strategy.position_size == 0
    if sizeMode == "全部本金"
        strategy.entry("L", strategy.long, comment = "BUY")          // 用 default_qty_type=percent_of_equity 100%
    else
        strategy.entry("L", strategy.long, qty = qty, comment = "BUY")
if sellSig and strategy.position_size > 0
    strategy.close("L", comment = "SELL")
if useStop and strategy.position_size > 0
    strategy.exit("SL", "L", stop = strategy.position_avg_price * (1 - stopPct / 100.0))
if eodBar and strategy.position_size != 0
    strategy.close_all(comment = "EOD")
// 回測窗結束 → 平掉未平倉, 讓報表數字對應完整期間
if not inWindow and strategy.position_size != 0
    strategy.close_all(comment = "窗口結束")

// ─────────────────────────── ⑨ 繪圖 ───────────────────────────
plot(hist, "Histogram", style = plot.style_columns,
     color = hist >= 0 ? (hist >= hist[1] ? color.new(color.green, 0) : color.new(color.green, 45))
                       : (hist <= hist[1] ? color.new(color.red, 0)   : color.new(color.red, 45)))
plot(dif, "DIF", color = color.new(color.orange, 0), linewidth = 2)
plot(dea, "DEA", color = color.new(color.aqua, 0), linewidth = 1)
hline(0)
bgcolor(inWindow ? color.new(color.blue, 94) : na, title = "回測期間底色")
plotshape(buySig  and inWindow, "買訊", style = shape.triangleup,   location = location.bottom, color = color.aqua, size = size.small, text = "B")
plotshape(sellSig and inWindow, "賣訊", style = shape.triangledown, location = location.top,    color = color.red,  size = size.small, text = "S")

// ─────────────────────────── ⑩ 報表: 交易次數 / 每筆 P&L / Total P&L ───────────────────────────
gRP      = "⑦ 報表"
showRpt  = input.bool(true, "顯示圖上報表", group = gRP)
maxRows  = input.int(25, "最多列出最近幾筆交易", minval = 1, maxval = 60, group = gRP,
     tooltip = "完整清單見 Strategy Tester → List of Trades (可匯出 CSV)")
rptPos   = input.string("右下", "報表位置", options = ["右下", "右上", "左下", "左上"], group = gRP)
txtSize  = input.string("tiny", "字體", options = ["tiny", "small", "normal"], group = gRP)

posV = rptPos == "右下" ? position.bottom_right : rptPos == "右上" ? position.top_right : rptPos == "左下" ? position.bottom_left : position.top_left
sizeV = txtSize == "tiny" ? size.tiny : txtSize == "small" ? size.small : size.normal

var table rpt = table.new(posV, 7, 70, border_width = 1, frame_width = 1, frame_color = color.gray)

if barstate.islast and showRpt
    table.clear(rpt, 0, 0, 6, 69)
    nT   = strategy.closedtrades
    nW   = strategy.wintrades
    nL   = strategy.losstrades
    net  = strategy.netprofit
    gpr  = strategy.grossprofit
    gls  = strategy.grossloss
    eq0  = strategy.initial_capital
    wr   = nT > 0 ? nW / nT * 100.0 : 0.0
    pf   = gls != 0 ? gpr / gls : na
    netP = net / eq0 * 100.0
    hdBg = color.new(color.gray, 70)
    // ── 摘要 ──
    for c = 0 to 6
        table.cell(rpt, c, 0, "", text_size = sizeV, bgcolor = color.new(color.blue, 40))
    table.cell(rpt, 0, 0, "回測摘要 · " + str.format_time(btStart, "yyyy-MM-dd", tzStr) + " → " + str.format_time(math.min(btEnd, timenow), "yyyy-MM-dd", tzStr),
         text_size = sizeV, text_color = color.white, bgcolor = color.new(color.blue, 40), text_halign = text.align_left)
    table.merge_cells(rpt, 0, 0, 6, 0)
    table.cell(rpt, 0, 1, "本金",       text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 1, 1, str.tostring(eq0, "#,###"), text_size = sizeV)
    table.cell(rpt, 2, 1, "交易次數",   text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 3, 1, str.tostring(nT), text_size = sizeV, text_color = color.blue)
    table.cell(rpt, 4, 1, "勝 / 負",    text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 5, 1, str.tostring(nW) + " / " + str.tostring(nL), text_size = sizeV)
    table.cell(rpt, 6, 1, "勝率 " + str.tostring(wr, "#.0") + "%", text_size = sizeV)
    table.cell(rpt, 0, 2, "總損益 $",   text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 1, 2, str.tostring(net, "#,###.##"), text_size = sizeV,
         text_color = net >= 0 ? color.green : color.red)
    table.cell(rpt, 2, 2, "總損益 %",   text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 3, 2, str.tostring(netP, "#.##") + "%", text_size = sizeV,
         text_color = net >= 0 ? color.green : color.red)
    table.cell(rpt, 4, 2, "期末權益",   text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 5, 2, str.tostring(eq0 + net, "#,###"), text_size = sizeV)
    table.cell(rpt, 6, 2, "PF " + (na(pf) ? "-" : str.tostring(pf, "#.##")), text_size = sizeV)
    table.cell(rpt, 0, 3, "毛利 / 毛損", text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 1, 3, str.tostring(gpr, "#,###") + " / " + str.tostring(gls, "#,###"), text_size = sizeV)
    table.cell(rpt, 2, 3, "最大回撤(佔本金)", text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 3, 3, str.tostring(strategy.max_drawdown / eq0 * 100.0, "#.##") + "%", text_size = sizeV, text_color = color.red)
    table.cell(rpt, 4, 3, "門檻(現值)", text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 5, 3, "深" + str.tostring(minDepth, "#.###") + " 面" + str.tostring(minArea, "#.##") + " 根" + str.tostring(minBars), text_size = sizeV)
    table.cell(rpt, 6, 3, thMode, text_size = sizeV)
    // ── 逐筆交易表頭 ──
    table.cell(rpt, 0, 4, "#",       text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 1, 4, "進場日",  text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 2, 4, "出場日",  text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 3, 4, "進場價",  text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 4, 4, "出場價",  text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 5, 4, "損益 $",  text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 6, 4, "損益 %",  text_size = sizeV, bgcolor = hdBg)
    // ── 逐筆交易 (最近 maxRows 筆) ──
    first = math.max(0, nT - maxRows)
    row   = 5
    if nT > 0
        for i = first to nT - 1
            pnl  = strategy.closedtrades.profit(i)
            ep   = strategy.closedtrades.entry_price(i)
            xp   = strategy.closedtrades.exit_price(i)
            pctR = ep != 0 ? (xp / ep - 1.0) * 100.0 : 0.0
            col  = pnl >= 0 ? color.green : color.red
            table.cell(rpt, 0, row, str.tostring(i + 1), text_size = sizeV)
            table.cell(rpt, 1, row, str.format_time(strategy.closedtrades.entry_time(i), "yyyy-MM-dd", tzStr), text_size = sizeV)
            table.cell(rpt, 2, row, str.format_time(strategy.closedtrades.exit_time(i),  "yyyy-MM-dd", tzStr), text_size = sizeV)
            table.cell(rpt, 3, row, str.tostring(ep, format.mintick), text_size = sizeV)
            table.cell(rpt, 4, row, str.tostring(xp, format.mintick), text_size = sizeV)
            table.cell(rpt, 5, row, str.tostring(pnl, "#,###.##"), text_size = sizeV, text_color = col)
            table.cell(rpt, 6, row, str.tostring(pctR, "#.##") + "%", text_size = sizeV, text_color = col)
            row += 1
        if nT > maxRows
            for c = 0 to 6
                table.cell(rpt, c, row, "", text_size = sizeV)
            table.cell(rpt, 0, row, "…僅顯示最近 " + str.tostring(maxRows) + " 筆, 共 " + str.tostring(nT) + " 筆; 完整清單見 Strategy Tester → List of Trades",
                 text_size = sizeV, text_color = color.gray, text_halign = text.align_left)
            table.merge_cells(rpt, 0, row, 6, row)
    else
        for c = 0 to 6
            table.cell(rpt, c, row, "", text_size = sizeV)
        table.cell(rpt, 0, row, "期內無交易 — 門檻太高或回測窗內無合格訊號, 請調 ④ 門檻或拉長 ① 期間",
             text_size = sizeV, text_color = color.orange, text_halign = text.align_left)
        table.merge_cells(rpt, 0, row, 6, row)

// ─────────────────────────── ⑪ 收盤把報表也輸出到 Pine Logs (方便複製) ───────────────────────────
if barstate.islastconfirmedhistory and showRpt
    log.info("===== MACD動能日線回測 {0} · {1} → {2} =====", syminfo.ticker,
         str.format_time(btStart, "yyyy-MM-dd", tzStr), str.format_time(btEnd, "yyyy-MM-dd", tzStr))
    log.info("交易次數 {0} · 勝 {1} 負 {2} · 總損益 {3} ({4}%) · 本金 {5}",
         strategy.closedtrades, strategy.wintrades, strategy.losstrades,
         str.tostring(strategy.netprofit, "#,###.##"),
         str.tostring(strategy.netprofit / strategy.initial_capital * 100.0, "#.##"),
         str.tostring(strategy.initial_capital, "#,###"))
    if strategy.closedtrades > 0
        for i = 0 to strategy.closedtrades - 1
            log.info("#{0} {1} → {2} | {3} → {4} | P&L {5} ({6}%)", i + 1,
                 str.format_time(strategy.closedtrades.entry_time(i), "yyyy-MM-dd", tzStr),
                 str.format_time(strategy.closedtrades.exit_time(i),  "yyyy-MM-dd", tzStr),
                 str.tostring(strategy.closedtrades.entry_price(i), format.mintick),
                 str.tostring(strategy.closedtrades.exit_price(i),  format.mintick),
                 str.tostring(strategy.closedtrades.profit(i), "#,###.##"),
                 str.tostring((strategy.closedtrades.exit_price(i) / strategy.closedtrades.entry_price(i) - 1.0) * 100.0, "#.##"))
