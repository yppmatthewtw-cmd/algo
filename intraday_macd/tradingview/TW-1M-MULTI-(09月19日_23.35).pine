// ═══════════════════════════════════════════════════════════════════════════════
//  TW-1M-MULTI-(09月19日_23:35)  ·  多策略同場回測比較 · 1 分鐘 · TradingView Pine Script v6
//  四處必須一致: strategy() 標題 = shorttitle = 檔名 = TradingView 腳本名稱 (Save 時輸入; 結尾的 ")" 不可漏)
//  本檔共 475 行; 最後一行是 "// ═══ END OF FILE ═══" → 貼上後若看不到那一行 = 內容被截斷 (檔案預覽視窗常只載入前 8KB)
//  正確貼法: 用「貼上工具」網頁按【複製全部程式碼】, 或下載 .pine 後用純文字編輯器開啟 → Ctrl+A → Ctrl+C
//
//  【這支腳本做甚麼】
//   把 13 個常見的日內做多策略放在【同一個回測窗口、同一套手續費滑點、同一組交易時段與收市強平規則】下各跑一次,
//   主圖右上直接印出每個策略的回測 report (交易次數 / 勝率 / 總報酬 / 最大回撤 / 獲利因子 / 平均每筆 / 最佳最差 / 平均持倉 / 捕獲率),
//   按總報酬由高到低排名, 並附「買入持有」與「期內最大昇幅」兩條基準線 → 一眼看出哪一個方法在這一個月的 SOXL 上真的有優勢。
//   ③ 選中的那一個策略會下真單, TradingView 內建 Strategy Tester 因此顯示它的逐筆明細; 其餘 12 個同時做虛擬回測。
//
//  【13 個策略】S01 MACD柱動能減弱(本專案) · S02 MACD DIF/DEA交叉 · S03 EMA 9/21 交叉 · S04 Supertrend轉向 ·
//   S05 RSI超賣回歸 · S06 布林下軌回歸 · S07 VWAP偏離回歸 · S08 開盤區間突破 · S09 動能突破+量能 ·
//   S10 三EMA+Supertrend共振 · S11 ATR標準化MACD · S12 MACD柱背離 · S13 隨機進場(安慰劑基準)
//   ※ S13 是對照組: 任何排在隨機進場下面的策略, 在這段資料上等於沒有優勢 — 這是判讀本表最重要的一條線。
//
//  【共用規則 — 保證比較公平】
//   · 只做多, 每次全部本金, 不加碼 (pyramiding = 0)
//   · 訊號一律在 K 線收盤確認, 下一根開盤成交 (process_orders_on_close = false), 不會偷看未來
//   · 手續費 0.03%/邊 + 滑點 2 tick, 虛擬回測與真單用同一組數字 (② 可改, 改完要同步改 strategy() 那一行)
//   · 美股時段 09:30-16:00 America/New_York (DST 自動) · 15:45 後不開新倉 · 15:58 強制平倉, 不留隔夜倉
//   · ② 可一鍵開「所有策略共用固定止損」, 開了就 13 個策略一起用, 比較仍然公平
//   · margin_long = 0, margin_short = 0 ← Pine v6 預設 margin 100% 會令「全部本金」下單被拒 (0 交易)
//
//  【回測期間】① 預設 方式 B 最近 30 天 (一個月); 另有 方式 A 最近 N 個交易日 (預設 21) / 方式 C 指定起迄日期 — 全部在 Inputs 設定
//   ※ 1 分 K 一個月約 8,200 根, TradingView 依方案只載入 5,000-20,000 根 → 實際回測從圖表最左那根開始, 報表標題顯示實際起始日與實際根數
//
//  【只設計給 1 分鐘】強制平倉時段 15:58-16:00 在 1 分 K 上剛好涵蓋收市前最後兩根; 換成 3 分/5 分 K 時這個時段可能落不到任何一根,
//   會變成留倉過夜 → 若要跑其他週期, 必須先把 ② 的「強制平倉時段」調寬 (例如 5 分 K 用 1545-1600)。報表最後一行會在週期不符時提醒。
//
//  【怎麼用】圖表切【SOXL · 1 分鐘】→ Pine Editor 貼上 → 檢查最後一行 → Save (輸入同名) → Add to chart
//   → 看主圖右上的比較表 → 選出前列策略 → 回 ③ 把它設為下真單 → 看 Strategy Tester 的逐筆明細與權益曲線
//  【怎麼讀】捕獲率 = 該策略總報酬 ÷ 期內最大昇幅; 獲利因子 < 1 = 賠錢; 交易次數 < 30 的勝率沒有統計意義, 只能當參考
//  版本戳 TW-1M-MULTI-(MM月DD日_HH:MM), 括號內 = 建置時間 HKT; 檔名以 . 代替 : (Windows 檔名不接受冒號); 本檔零延續行, 每個語句自成一行
// ═══════════════════════════════════════════════════════════════════════════════
//@version=6
strategy("TW-1M-MULTI-(09月19日_23:35)", shorttitle="TW-1M-MULTI-(09月19日_23:35)", overlay = true, initial_capital = 100000, margin_long = 0, margin_short = 0, default_qty_type = strategy.percent_of_equity, default_qty_value = 100, commission_type = strategy.commission.percent, commission_value = 0.03, slippage = 2, process_orders_on_close = false, calc_on_every_tick = false, pyramiding = 0, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500)

// ═══════════════════════════ ① 回測期間 (全部可在 Inputs 改, 預設一個月) ═══════════════════════════
gBT        = "① 回測期間"
winMode    = input.string("最近 N 天 (日曆)", "回測期間方式 (三選一; 本版預設一個月)", options = ["最近 N 個交易日", "最近 N 天 (日曆)", "指定日期"], group = gBT, display = display.none)
tradDays   = input.int(21, "方式 A · 最近 N 個交易日", minval = 1, maxval = 500, group = gBT, display = display.none)
lookbackD  = input.int(30, "方式 B · 最近 N 天 (日曆; 30 = 一個月)", minval = 1, maxval = 2000, group = gBT, display = display.none)
startIn    = input.time(timestamp("2025-08-19T00:00:00"), "方式 C · 起始", group = gBT, display = display.none)
endIn      = input.time(timestamp("2026-09-19T00:00:00"), "方式 C · 結束", group = gBT, display = display.none)
tfExpect   = input.string("1", "策略設計的 K 線週期 (僅提示, 不改變運算)", options = ["1", "3", "5", "15", "30", "60", "D"], group = gBT, display = display.none)
tickerHint = input.string("SOXL", "本版設計針對的商品 (僅提示)", group = gBT, display = display.none)

tzX = syminfo.timezone
var int tdStart = na
if na(tdStart)
    dd = 0
    ms = last_bar_time
    while dd < tradDays
        ms := ms - 86400000
        dw = dayofweek(ms, tzX)
        if dw != dayofweek.saturday and dw != dayofweek.sunday
            dd := dd + 1
    tdStart := ms

btStart  = winMode == "最近 N 個交易日" ? tdStart : winMode == "最近 N 天 (日曆)" ? timenow - lookbackD * 86400000 : startIn
btEnd    = winMode == "指定日期" ? endIn : timenow
inWindow = time >= btStart and time <= btEnd

// ═══════════════════════════ ② 盤中時段 + 成本 (所有策略共用同一套規則) ═══════════════════════════
gS       = "② 時段與成本 (所有策略共用)"
mktPre   = input.string("美股", "市場預設", options = ["美股", "港股", "自訂"], group = gS, display = display.none)
sessCust = input.session("0930-1600", "自訂: 交易時段", group = gS, display = display.none)
tzCust   = input.string("America/New_York", "自訂: 時區", group = gS, display = display.none)
noEntry  = input.session("1545-1600", "收市前不開新倉時段", group = gS, display = display.none)
eodSess  = input.session("1558-1600", "強制平倉時段 (不留隔夜倉)", group = gS, display = display.none)
commPct  = input.float(0.03, "單邊手續費 % (需與 strategy() commission_value 一致)", minval = 0, step = 0.01, group = gS, display = display.none)
slipTk   = input.int(2, "單邊滑點 tick (需與 strategy() slippage 一致)", minval = 0, group = gS, display = display.none)
useStop  = input.bool(false, "所有策略共用固定止損", group = gS, display = display.none)
stopPct  = input.float(1.5, "固定止損 %", minval = 0.1, step = 0.1, group = gS, display = display.none)

sessStr = mktPre == "港股" ? "0930-1200,1300-1600" : mktPre == "美股" ? "0930-1600" : sessCust
tzStr   = mktPre == "港股" ? "Asia/Hong_Kong" : mktPre == "美股" ? "America/New_York" : tzCust
isIntra = timeframe.isintraday
inSess  = not isIntra or not na(time(timeframe.period, sessStr, tzStr))
blockNew = isIntra and not na(time(timeframe.period, noEntry, tzStr))
eodBar   = isIntra and not na(time(timeframe.period, eodSess, tzStr))
newSess  = inSess and not inSess[1]
entryOK  = inWindow and inSess and not blockNew and not eodBar
tzMatch  = tzStr == syminfo.timezone

// ═══════════════════════════ ③ 下真單的策略 (其餘 12 個同時做虛擬回測) ═══════════════════════════
gLive  = "③ 下真單的策略"
NS     = 13
var string[] SNAME = array.from("S01 MACD柱動能減弱", "S02 MACD DIF/DEA交叉", "S03 EMA 9/21 交叉", "S04 Supertrend 轉向", "S05 RSI 超賣回歸", "S06 布林下軌回歸", "S07 VWAP 偏離回歸", "S08 開盤區間突破", "S09 動能突破+量能", "S10 三EMA+ST共振", "S11 ATR標準化MACD", "S12 MACD柱背離", "S13 隨機進場(安慰劑)")
liveName = input.string("S01 MACD柱動能減弱", "用哪一個策略下真單 (Strategy Tester 只反映這一個)", options = ["S01 MACD柱動能減弱", "S02 MACD DIF/DEA交叉", "S03 EMA 9/21 交叉", "S04 Supertrend 轉向", "S05 RSI 超賣回歸", "S06 布林下軌回歸", "S07 VWAP 偏離回歸", "S08 開盤區間突破", "S09 動能突破+量能", "S10 三EMA+ST共振", "S11 ATR標準化MACD", "S12 MACD柱背離", "S13 隨機進場(安慰劑)", "不下單 (只做比較表)"], group = gLive, display = display.none)
liveIdx = array.indexof(SNAME, liveName)

// ═══════════════════════════ ④ 各策略參數 ═══════════════════════════
gP1 = "④a S01 / S11 · MACD 柱動能減弱"
fastLen  = input.int(12, "MACD 快線", minval = 1, group = gP1, display = display.none)
slowLen  = input.int(26, "MACD 慢線", minval = 2, group = gP1, display = display.none)
sigLen   = input.int(9, "MACD 訊號線", minval = 1, group = gP1, display = display.none)
fadeBuy  = input.int(2, "買: 連續幾根淺紅 (負柱收縮) 完成即買", minval = 1, maxval = 6, group = gP1, display = display.none)
fadeSell = input.int(2, "賣: 連續幾根淺綠 (正柱收縮) 完成即賣", minval = 1, maxval = 6, group = gP1, display = display.none)
kBuy     = input.float(1.0, "買: 下跌動能門檻倍數 (0 = 不要求)", minval = 0, step = 0.1, group = gP1, display = display.none)
kSell    = input.float(1.0, "賣: 上昇動能門檻倍數 (0 = 不要求)", minval = 0, step = 0.1, group = gP1, display = display.none)
mbBuy    = input.int(3, "買: 負柱段最少根數", minval = 1, group = gP1, display = display.none)
mbSell   = input.int(3, "賣: 正柱段最少根數", minval = 1, group = gP1, display = display.none)
pctLen   = input.int(250, "自動深度基準: 取樣根數", minval = 20, group = gP1, display = display.none)
depthPct = input.int(50, "自動深度基準: 百分位", minval = 1, maxval = 99, group = gP1, display = display.none)
areaFac  = input.float(0.5, "面積係數", minval = 0, step = 0.1, group = gP1, display = display.none)
kATR     = input.float(0.35, "S11: 柱深度門檻 (ATR 倍數)", minval = 0, step = 0.05, group = gP1, display = display.none)

gP2 = "④b S03-S07 · 均線 / 通道 / 震盪"
emaF   = input.int(9, "S03/S10: 快 EMA", minval = 1, group = gP2, display = display.none)
emaM   = input.int(21, "S03/S10: 中 EMA", minval = 2, group = gP2, display = display.none)
emaS   = input.int(50, "S09/S10: 慢 EMA", minval = 3, group = gP2, display = display.none)
stAtr  = input.int(10, "S04/S10: Supertrend ATR 長度", minval = 1, group = gP2, display = display.none)
stMult = input.float(3.0, "S04/S10: Supertrend 倍數", minval = 0.5, step = 0.1, group = gP2, display = display.none)
rsiLen = input.int(14, "S05: RSI 長度", minval = 2, group = gP2, display = display.none)
rsiBuy = input.float(30, "S05: 買入 — RSI 上穿", minval = 1, maxval = 50, group = gP2, display = display.none)
rsiEx  = input.float(55, "S05: 賣出 — RSI 上穿", minval = 30, maxval = 99, group = gP2, display = display.none)
bbLen  = input.int(20, "S06: 布林長度", minval = 2, group = gP2, display = display.none)
bbMult = input.float(2.0, "S06: 布林倍數", minval = 0.5, step = 0.1, group = gP2, display = display.none)
vwapK  = input.float(1.5, "S07: VWAP 偏離門檻 (ATR 倍數)", minval = 0.1, step = 0.1, group = gP2, display = display.none)

gP3 = "④c S08 / S09 / S12 / S13 · 突破 / 背離 / 安慰劑"
orbBars = input.int(15, "S08: 開盤區間根數 (1 分鐘 = 分鐘數)", minval = 1, group = gP3, display = display.none)
brkLen  = input.int(20, "S09: 突破回看根數", minval = 2, group = gP3, display = display.none)
volMult = input.float(1.5, "S09: 量能倍數門檻", minval = 0, step = 0.1, group = gP3, display = display.none)
divLen  = input.int(20, "S12: 背離回看根數", minval = 3, group = gP3, display = display.none)
pRand   = input.float(0.004, "S13: 每根 K 進場機率 (0.004 ≈ 每日 1.5 筆)", minval = 0.0001, maxval = 0.5, step = 0.001, group = gP3, display = display.none)
holdBar = input.int(30, "S13: 固定持倉根數", minval = 1, group = gP3, display = display.none)

gR = "⑤ 報表"
showRpt = input.bool(true, "顯示策略比較報表", group = gR, display = display.none)
rptPos  = input.string("右上", "報表位置", options = ["右上", "左上", "右下", "左下", "中上"], group = gR, display = display.none)
rptSize = input.string("細", "報表字型", options = ["極細", "細", "正常"], group = gR, display = display.none)
showBg  = input.bool(true, "回測期間底色", group = gR, display = display.none)
showMk  = input.bool(true, "主圖顯示真單成交標記", group = gR, display = display.none)

// ═══════════════════════════ ⑥ 共用指標 ═══════════════════════════
[difL, deaL, histL] = ta.macd(close, fastLen, slowLen, sigLen)
dif  = difL
dea  = deaL
hist = histL
atr  = ta.atr(14)
e1   = ta.ema(close, emaF)
e2   = ta.ema(close, emaM)
e3   = ta.ema(close, emaS)
[stVal, stDir] = ta.supertrend(stMult, stAtr)
plot(stVal, "Supertrend (S04/S10)", color = stDir == -1 ? color.new(color.green, 60) : color.new(color.red, 60), display = display.none)
rsiV = ta.rsi(close, rsiLen)
bbB  = ta.sma(close, bbLen)
bbD  = bbMult * ta.stdev(close, bbLen)
bbLo = bbB - bbD
volA = ta.sma(volume, 20)
donH = ta.highest(high, brkLen)[1]
donL = ta.lowest(low, brkLen)[1]
pLowN  = ta.lowest(low, divLen)[1]
pHighN = ta.highest(high, divLen)[1]
hLowN  = ta.lowest(hist, divLen)[1]
hHighN = ta.highest(hist, divLen)[1]

// 每節重設的 VWAP (自行累加, 不依賴 ta.vwap, 日線圖也不會報錯)
var float cumPV = 0.0
var float cumVo = 0.0
if newSess
    cumPV := 0.0
    cumVo := 0.0
if inSess
    cumPV := cumPV + hlc3 * volume
    cumVo := cumVo + volume
vwapV = cumVo > 0 ? cumPV / cumVo : close
devA  = na(atr) or atr == 0 ? 0.0 : (close - vwapV) / atr

// 開盤區間 (每節前 orbBars 根)
var float orbH = na
var float orbL = na
var int   orbN = 0
var bool  orbUsed = false
if newSess
    orbH := high
    orbL := low
    orbN := 1
    orbUsed := false
else if inSess
    orbN := orbN + 1
    if orbN <= orbBars
        orbH := math.max(orbH, high)
        orbL := math.min(orbL, low)
orbReady = inSess and orbN > orbBars and not na(orbH)

// MACD 柱段統計 (S01 / S11 的「儲夠動能」判斷)
hPct = close != 0 ? math.abs(hist) / close * 100.0 : 0.0
hAtr = na(atr) or atr == 0 ? 0.0 : math.abs(hist) / atr
sgn  = hist > 0 ? 1 : hist < 0 ? -1 : 0
var int   segSign  = 0
var int   segBars  = 0
var float segArea  = 0.0
var float segDepth = 0.0
var float segDepA  = 0.0
if sgn != 0
    if sgn != segSign
        segSign  := sgn
        segBars  := 1
        segArea  := hPct
        segDepth := hPct
        segDepA  := hAtr
    else
        segBars  := segBars + 1
        segArea  := segArea + hPct
        segDepth := math.max(segDepth, hPct)
        segDepA  := math.max(segDepA, hAtr)
autoDepth = ta.percentile_linear_interpolation(hPct, pctLen, depthPct)
dBuy  = autoDepth * kBuy
dSell = autoDepth * kSell
aBuy  = dBuy * mbBuy * areaFac
aSell = dSell * mbSell * areaFac
fadeDn = hist < 0 and hist > hist[1]
fadeUp = hist > 0 and hist < hist[1]
var int nFadeDn = 0
var int nFadeUp = 0
nFadeDn := fadeDn ? nFadeDn + 1 : 0
nFadeUp := fadeUp ? nFadeUp + 1 : 0
okBuy  = kBuy  <= 0 or (segBars >= mbBuy  and segDepth >= dBuy  and segArea >= aBuy)
okSell = kSell <= 0 or (segBars >= mbSell and segDepth >= dSell and segArea >= aSell)
okBuyA  = kATR <= 0 or (segBars >= mbBuy  and segDepA >= kATR)
okSellA = kATR <= 0 or (segBars >= mbSell and segDepA >= kATR)

// 偽亂數 (同一根 K 永遠得到同一個值 → 結果可重現)
rndRaw = math.abs(math.sin(bar_index * 12.9898 + 78.233) * 43758.5453)
rndU   = rndRaw - math.floor(rndRaw)

// ═══════════════════════════ ⑦ 13 個策略的進 / 出場訊號 (全部收盤確認, 只做多) ═══════════════════════════
s01L = nFadeDn == fadeBuy  and segSign == -1 and okBuy
s01X = nFadeUp == fadeSell and segSign ==  1 and okSell
s02L = ta.crossover(dif, dea)
s02X = ta.crossunder(dif, dea)
s03L = ta.crossover(e1, e2)
s03X = ta.crossunder(e1, e2)
s04L = stDir == -1 and stDir[1] == 1
s04X = stDir == 1 and stDir[1] == -1
s05L = ta.crossover(rsiV, rsiBuy)
s05X = ta.crossover(rsiV, rsiEx)
s06L = ta.crossover(close, bbLo)
s06X = ta.crossover(close, bbB)
s07L = ta.crossover(devA, -vwapK)
s07X = ta.crossover(devA, 0.0)
orbXup = ta.crossover(close, orbH)
orbXdn = ta.crossunder(close, orbL)
s08Lraw = orbReady and not orbUsed and orbXup
if s08Lraw
    orbUsed := true
s08L = s08Lraw
s08X = orbReady and orbXdn
s09L = close > donH and volume > volA * volMult and close > e3
s09Xa = ta.crossunder(close, e2)
s09Xb = ta.crossunder(close, donL)
s09X = s09Xa or s09Xb
s10L = e1 > e2 and e2 > e3 and stDir == -1 and not (e1[1] > e2[1] and e2[1] > e3[1] and stDir[1] == -1)
s10X = e1 < e2 or stDir == 1
s11L = nFadeDn == fadeBuy  and segSign == -1 and okBuyA
s11X = nFadeUp == fadeSell and segSign ==  1 and okSellA
s12L = low <= pLowN and hist > hLowN
s12X = high >= pHighN and hist < hHighN
s13L = rndU < pRand
s13X = false

sigL = array.from(s01L, s02L, s03L, s04L, s05L, s06L, s07L, s08L, s09L, s10L, s11L, s12L, s13L)
sigX = array.from(s01X, s02X, s03X, s04X, s05X, s06X, s07X, s08X, s09X, s10X, s11X, s12X, s13X)

// ═══════════════════════════ ⑧ 虛擬回測引擎 (13 個策略同時跑, 規則與真單完全一致) ═══════════════════════════
// 成交方式: 本根收盤出訊號 → 下一根開盤成交 (與 process_orders_on_close = false 相同)
var float[] vEq    = array.new_float(NS, 1.0)
var int[]   vPos   = array.new_int(NS, 0)
var int[]   vPend  = array.new_int(NS, 0)
var float[] vEntry = array.new_float(NS, 0.0)
var int[]   vTr    = array.new_int(NS, 0)
var int[]   vWin   = array.new_int(NS, 0)
var float[] vGp    = array.new_float(NS, 0.0)
var float[] vGl    = array.new_float(NS, 0.0)
var float[] vPeak  = array.new_float(NS, 1.0)
var float[] vDD    = array.new_float(NS, 0.0)
var int[]   vHold  = array.new_int(NS, 0)
var int[]   vHoldS = array.new_int(NS, 0)
var float[] vBest  = array.new_float(NS, -999.0)
var float[] vWorst = array.new_float(NS, 999.0)

// 期內最大昇幅 / 買入持有
var float runMin  = na
var float maxRise = 0.0
var float winOpen = na
var int   winBars = 0
var int   winDays = 0
var int   winT0   = na
var int   lastD   = na
if inWindow and inSess
    prevMin = na(runMin) ? low : runMin
    maxRise := math.max(maxRise, (high - prevMin) / prevMin * 100.0)
    runMin  := math.min(prevMin, low)
    winBars := winBars + 1
    if na(winOpen)
        winOpen := open
        winT0   := time
    dcur = dayofmonth(time, tzStr)
    if na(lastD) or dcur != lastD
        winDays := winDays + 1
        lastD   := dcur
bhRet = na(winOpen) ? 0.0 : (close / winOpen - 1.0) * 100.0

cost2 = 2.0 * commPct / 100.0
for i = 0 to NS - 1
    // 1) 上一根掛的單在本根開盤成交
    pd = array.get(vPend, i)
    if pd == 1
        array.set(vPos, i, 1)
        array.set(vEntry, i, open + slipTk * syminfo.mintick)
        array.set(vHold, i, 0)
        array.set(vPend, i, 0)
    else if pd == -1
        ep = array.get(vEntry, i)
        xp = open - slipTk * syminfo.mintick
        r  = xp / ep - 1.0 - cost2
        array.set(vEq, i, array.get(vEq, i) * (1.0 + r))
        array.set(vTr, i, array.get(vTr, i) + 1)
        array.set(vHoldS, i, array.get(vHoldS, i) + array.get(vHold, i))
        if r > 0
            array.set(vWin, i, array.get(vWin, i) + 1)
            array.set(vGp, i, array.get(vGp, i) + r)
        else
            array.set(vGl, i, array.get(vGl, i) - r)
        array.set(vBest, i, math.max(array.get(vBest, i), r * 100.0))
        array.set(vWorst, i, math.min(array.get(vWorst, i), r * 100.0))
        array.set(vPos, i, 0)
        array.set(vPend, i, 0)
    // 1b) 固定止損 (成交當根收盤才生效, 開盤跳空則以開盤成交)
    if useStop and pd != 1 and array.get(vPos, i) == 1
        eps = array.get(vEntry, i)
        stp = eps * (1.0 - stopPct / 100.0)
        if low <= stp
            xps = math.min(open, stp) - slipTk * syminfo.mintick
            rs  = xps / eps - 1.0 - cost2
            array.set(vEq, i, array.get(vEq, i) * (1.0 + rs))
            array.set(vTr, i, array.get(vTr, i) + 1)
            array.set(vHoldS, i, array.get(vHoldS, i) + array.get(vHold, i))
            if rs > 0
                array.set(vWin, i, array.get(vWin, i) + 1)
                array.set(vGp, i, array.get(vGp, i) + rs)
            else
                array.set(vGl, i, array.get(vGl, i) - rs)
            array.set(vBest, i, math.max(array.get(vBest, i), rs * 100.0))
            array.set(vWorst, i, math.min(array.get(vWorst, i), rs * 100.0))
            array.set(vPos, i, 0)
            array.set(vPend, i, 0)
    // 2) 逐根按市值計算權益曲線 → 最大回撤
    pn = array.get(vPos, i)
    if pn == 1
        array.set(vHold, i, array.get(vHold, i) + 1)
    mtm = pn == 1 ? array.get(vEq, i) * (close / array.get(vEntry, i)) * (1.0 - cost2) : array.get(vEq, i)
    if mtm > array.get(vPeak, i)
        array.set(vPeak, i, mtm)
    ddNow = array.get(vPeak, i) > 0 ? (1.0 - mtm / array.get(vPeak, i)) * 100.0 : 0.0
    if ddNow > array.get(vDD, i)
        array.set(vDD, i, ddNow)
    // 3) 本根收盤評估訊號 → 掛到下一根開盤
    bs = array.get(sigL, i)
    xs = i == 12 ? array.get(vHold, i) >= holdBar : array.get(sigX, i)
    if pn == 0 and bs and entryOK
        array.set(vPend, i, 1)
    else if pn == 1 and (xs or eodBar or not inWindow)
        array.set(vPend, i, -1)

// ═══════════════════════════ ⑨ 真單 (只有 ③ 選中的那一個策略會下單) ═══════════════════════════
var int liveHold = 0
liveHold := strategy.position_size > 0 ? (strategy.position_size[1] > 0 ? liveHold + 1 : 1) : 0
safeIdx = liveIdx >= 0 ? liveIdx : 0
liveL = liveIdx >= 0 and array.get(sigL, safeIdx)
liveX = liveIdx >= 0 and (safeIdx == 12 ? liveHold >= holdBar : array.get(sigX, safeIdx))
if liveIdx >= 0 and entryOK and liveL and strategy.position_size == 0
    strategy.entry("多", strategy.long, comment = liveName)
if liveIdx >= 0 and strategy.position_size > 0 and (liveX or eodBar)
    strategy.close("多", comment = "平倉")
if useStop and liveIdx >= 0 and strategy.position_size > 0
    strategy.exit("止損", from_entry = "多", stop = strategy.position_avg_price * (1.0 - stopPct / 100.0))
if not inWindow and strategy.position_size != 0
    strategy.close_all(comment = "窗口外")

posSz      = strategy.position_size
justFilled = posSz > 0 and posSz[1] <= 0
justClosed = posSz <= 0 and posSz[1] > 0
plotshape(showMk and justFilled, title = "買入成交", style = shape.triangleup, location = location.belowbar, color = color.new(color.aqua, 0), size = size.tiny)
plotshape(showMk and justClosed, title = "賣出成交", style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0), size = size.tiny)
bgcolor(showBg and inWindow ? color.new(color.blue, 94) : na, title = "回測期間底色")

// ═══════════════════════════ ⑩ 策略比較報表 (每個策略一行 = 該策略的回測 report) ═══════════════════════════
posR = rptPos == "左上" ? position.top_left : rptPos == "右下" ? position.bottom_right : rptPos == "左下" ? position.bottom_left : rptPos == "中上" ? position.top_center : position.top_right
szR  = rptSize == "極細" ? size.tiny : rptSize == "正常" ? size.normal : size.small
var table rpt = table.new(posR, 11, 22, border_width = 1, border_color = color.new(color.gray, 60))
var bool rptInit = false
barMin = timeframe.in_seconds() / 60.0
bhRow  = NS + 4
ftRow  = NS + 5

if barstate.islast and showRpt
    hBg = color.new(color.navy, 15)
    tBg = color.new(color.black, 20)
    rBg = color.new(color.black, 55)
    txt = color.white
    // 起始日顯示「窗口內實際第一根 K」而非設定值: 1 分 K 一個月約 8,200 根, TradingView 常載不滿, 實際起點會比設定晚
    t0str = na(winT0) ? "無資料" : str.format_time(winT0, "yyyy-MM-dd", tzStr)
    t1str = str.format_time(winMode == "指定日期" ? btEnd : last_bar_time, "yyyy-MM-dd", tzStr)
    title1 = "多策略同場回測 · " + syminfo.ticker + " · " + timeframe.period + " 分鐘 · 同一窗口 / 同一成本 / 同一時段 / 全部只做多"
    info1 = "窗口 " + (winMode == "最近 N 個交易日" ? str.tostring(tradDays) + " 個交易日" : winMode == "最近 N 天 (日曆)" ? str.tostring(lookbackD) + " 天" : "指定日期") + " · 實際 " + str.tostring(winDays) + " 個交易日 / " + str.tostring(winBars) + " 根 K · 實際起 " + t0str + " 迄 " + t1str
    info2 = "期內最大昇幅 " + str.tostring(maxRise, "#.##") + "% · 買入持有 " + str.tostring(bhRet, "#.##") + "% · 手續費 " + str.tostring(commPct, "#.##") + "%/邊 · 滑點 " + str.tostring(slipTk) + " tick · 止損 " + (useStop ? str.tostring(stopPct, "#.#") + "%" : "關") + " · 下真單 " + liveName
    warn = winBars == 0 ? "⚠ 窗口內無 K 線 — 檢查 ① 期間與 ② 時段/時區 (本商品交易所時區 " + syminfo.timezone + ")" : not tzMatch ? "⚠ 策略時區 " + tzStr + " 與本商品 " + syminfo.timezone + " 不同 — 請到 ② 改市場預設" : timeframe.period != tfExpect ? "⚠ 本版設計為 " + tfExpect + " 分鐘, 目前圖表為 " + timeframe.period + " — 非 1 分鐘時請把 ② 的強制平倉時段調寬, 否則可能留倉過夜" : syminfo.ticker != tickerHint ? "提示: 本版預設針對 " + tickerHint + ", 目前為 " + syminfo.ticker + " (仍可正常運算)" : "捕獲率 = 該策略總報酬 ÷ 期內最大昇幅; S13 隨機進場是安慰劑基準 — 排在它下面的策略等於沒有優勢"
    // 合併過的儲存格不可重複合併, 也不可再用 table.cell() 寫入 → 只在第一次建立, 之後用 cell_set_text 更新
    if not rptInit
        for cf = 1 to 10
            table.cell(rpt, cf, 0, "", text_size = szR, bgcolor = tBg)
            table.cell(rpt, cf, 1, "", text_size = szR, bgcolor = tBg)
            table.cell(rpt, cf, 2, "", text_size = szR, bgcolor = tBg)
            table.cell(rpt, cf, ftRow, "", text_size = szR, bgcolor = tBg)
        table.cell(rpt, 0, 0, title1, text_size = szR, text_color = color.yellow, bgcolor = tBg, text_halign = text.align_left)
        table.cell(rpt, 0, 1, info1, text_size = szR, text_color = txt, bgcolor = tBg, text_halign = text.align_left)
        table.cell(rpt, 0, 2, info2, text_size = szR, text_color = color.aqua, bgcolor = tBg, text_halign = text.align_left)
        table.cell(rpt, 0, ftRow, warn, text_size = szR, text_color = color.orange, bgcolor = tBg, text_halign = text.align_left)
        table.merge_cells(rpt, 0, 0, 10, 0)
        table.merge_cells(rpt, 0, 1, 10, 1)
        table.merge_cells(rpt, 0, 2, 10, 2)
        table.merge_cells(rpt, 0, ftRow, 10, ftRow)
        rptInit := true
    else
        table.cell_set_text(rpt, 0, 1, info1)
        table.cell_set_text(rpt, 0, 2, info2)
        table.cell_set_text(rpt, 0, ftRow, warn)
    string[] hd = array.from("排名", "策略", "交易", "勝率", "總報酬%", "最大回撤%", "獲利因子", "平均每筆%", "最佳/最差%", "平均持倉分", "捕獲率%")
    for c = 0 to 10
        table.cell(rpt, c, 3, array.get(hd, c), text_size = szR, text_color = txt, bgcolor = hBg)
    float[] retA = array.new_float(NS, 0.0)
    for i3 = 0 to NS - 1
        array.set(retA, i3, (array.get(vEq, i3) - 1.0) * 100.0)
    int[] ord = array.sort_indices(retA, order.descending)
    for rk = 0 to NS - 1
        si  = array.get(ord, rk)
        rw  = rk + 4
        tr  = array.get(vTr, si)
        wr  = tr > 0 ? array.get(vWin, si) * 100.0 / tr : 0.0
        rt  = array.get(retA, si)
        dd  = array.get(vDD, si)
        gp  = array.get(vGp, si)
        gl  = array.get(vGl, si)
        pf  = gl > 0 ? gp / gl : na
        avg = tr > 0 ? rt / tr : 0.0
        hm  = tr > 0 ? array.get(vHoldS, si) * barMin / tr : 0.0
        cap = maxRise > 0 ? rt / maxRise * 100.0 : 0.0
        bg  = si == liveIdx ? color.new(color.orange, 55) : rk % 2 == 0 ? rBg : tBg
        rc  = rt > 0 ? color.lime : rt < 0 ? color.red : txt
        table.cell(rpt, 0, rw, str.tostring(rk + 1), text_size = szR, text_color = txt, bgcolor = bg)
        table.cell(rpt, 1, rw, array.get(SNAME, si), text_size = szR, text_color = si == liveIdx ? color.yellow : txt, bgcolor = bg, text_halign = text.align_left)
        table.cell(rpt, 2, rw, str.tostring(tr), text_size = szR, text_color = tr == 0 ? color.gray : txt, bgcolor = bg)
        table.cell(rpt, 3, rw, tr > 0 ? str.tostring(wr, "#.#") + "%" : "—", text_size = szR, text_color = wr >= 50 ? color.lime : txt, bgcolor = bg)
        table.cell(rpt, 4, rw, str.tostring(rt, "#.##") + "%", text_size = szR, text_color = rc, bgcolor = bg)
        table.cell(rpt, 5, rw, str.tostring(dd, "#.##") + "%", text_size = szR, text_color = dd > 10 ? color.red : txt, bgcolor = bg)
        table.cell(rpt, 6, rw, na(pf) ? "—" : str.tostring(pf, "#.##"), text_size = szR, text_color = na(pf) ? color.gray : pf >= 1.0 ? color.lime : color.red, bgcolor = bg)
        table.cell(rpt, 7, rw, tr > 0 ? str.tostring(avg, "#.###") + "%" : "—", text_size = szR, text_color = txt, bgcolor = bg)
        table.cell(rpt, 8, rw, tr > 0 ? str.tostring(array.get(vBest, si), "#.#") + " / " + str.tostring(array.get(vWorst, si), "#.#") : "—", text_size = szR, text_color = txt, bgcolor = bg)
        table.cell(rpt, 9, rw, tr > 0 ? str.tostring(hm, "#.#") : "—", text_size = szR, text_color = txt, bgcolor = bg)
        table.cell(rpt, 10, rw, str.tostring(cap, "#.#") + "%", text_size = szR, text_color = cap >= 30 ? color.lime : txt, bgcolor = bg)
    table.cell(rpt, 0, bhRow, "—", text_size = szR, text_color = txt, bgcolor = hBg)
    table.cell(rpt, 1, bhRow, "B&H 買入持有 (窗口首根→現在)", text_size = szR, text_color = color.aqua, bgcolor = hBg, text_halign = text.align_left)
    table.cell(rpt, 2, bhRow, "1", text_size = szR, text_color = txt, bgcolor = hBg)
    table.cell(rpt, 3, bhRow, "—", text_size = szR, text_color = txt, bgcolor = hBg)
    table.cell(rpt, 4, bhRow, str.tostring(bhRet, "#.##") + "%", text_size = szR, text_color = bhRet > 0 ? color.lime : color.red, bgcolor = hBg)
    for c2 = 5 to 9
        table.cell(rpt, c2, bhRow, "—", text_size = szR, text_color = txt, bgcolor = hBg)
    table.cell(rpt, 10, bhRow, maxRise > 0 ? str.tostring(bhRet / maxRise * 100.0, "#.#") + "%" : "—", text_size = szR, text_color = txt, bgcolor = hBg)
// ═══ END OF FILE ═══ TW-1M-MULTI-(09月19日_23:35) · 全檔共 475 行 · 看不到這一行 = 貼上的內容被截斷, 請用「貼上工具」網頁的【複製全部程式碼】 ═══
