// ═══════════════════════════════════════════════════════════════════════════════
//  TV-1M-RSI-mode2_(09月20日; 15:52)  ·  模式 2 (RSI 超賣回歸 升級版) 專用副圖 · 配合主策略 TV-1M-dashboard_(mode 1-4) 一起掛
//  升級 (消化 cRSI + RSI Swing): 超賣/超買門檻預設【動態】= 最近 120 根 RSI 的第 10 / 90 百分位 (固定 30 在 SOXL 1 分 K 幾乎碰不到);
//  買訊 = RSI 上穿超賣界 且 結構過濾通過 (這次超賣區最低價高於上一次 = HL; 離開超賣區那一根定型, 不重繪); 可改不過濾或再加 HH
//  顯示: 深棕粗線 RSI · 綠/紅細線 = 動態上下界 · ▲ 淺藍 = 過濾後買訊 · ▲ 灰小 = 被 HL 過濾掉 · ▼ 淺紅 = 賣訊 · HL/LL HH/LH 標在極值那根 K 上
//  ② 的 RSI 長度 / 門檻方式 / 百分位 / 結構過濾 / 賣訊方式 必須與主策略 ④c 一致; 這支不下單; plot 的 title 必須是常數字串
//  四處必須一致: 標題 = shorttitle = 檔名 = TradingView 腳本名稱 (結尾的 ")" 不可漏); 本檔共 176 行, 最後一行是 END OF FILE
// ═══════════════════════════════════════════════════════════════════════════════
//@version=6
indicator("TV-1M-RSI-mode2_(09月20日; 15:52)", shorttitle="TV-1M-RSI-mode2_(09月20日; 15:52)", overlay = false, max_labels_count = 500, max_lines_count = 500)

// ─────────────────────────── ① 回測期間 (與主策略同一套設定, 只用來畫底色) ───────────────────────────
gBT        = "① 回測期間 (與主策略對齊)"
winMode    = input.string("最近 N 天 (日曆)", "回測期間方式 (三選一; 預設一個月)", options = ["最近 N 個交易日", "最近 N 天 (日曆)", "指定日期"], group = gBT, display = display.none)
tradDays   = input.int(21, "方式 A · 最近 N 個交易日", minval = 1, maxval = 250, group = gBT, display = display.none)
lookbackD  = input.int(30, "方式 B · 最近 N 天 (日曆; 30 = 一個月)", minval = 1, group = gBT, display = display.none)
startIn    = input.time(timestamp("19 Aug 2026 00:00 -0400"), "方式 C · 開始日期 (含)", group = gBT, display = display.none)
endIn      = input.time(timestamp("19 Sep 2026 23:59 -0400"), "方式 C · 結束日期 (含)", group = gBT, display = display.none)
tzX        = syminfo.timezone
lastDay0   = timestamp(tzX, year(last_bar_time, tzX), month(last_bar_time, tzX), dayofmonth(last_bar_time, tzX), 0, 0, 0)
var int tdStart = na
if na(tdStart)
    ddT   = lastDay0
    cntD  = 1
    guardD = 0
    while cntD < tradDays and guardD < 400
        ddT    -= 86400000
        guardD += 1
        dwD = dayofweek(ddT + 43200000, tzX)
        if dwD != dayofweek.saturday and dwD != dayofweek.sunday
            cntD += 1
    tdStart := ddT
btStart    = winMode == "最近 N 個交易日" ? tdStart : winMode == "最近 N 天 (日曆)" ? timenow - lookbackD * 86400000 : startIn
btEnd      = winMode == "指定日期" ? endIn : timenow
inWindow   = time >= btStart and time <= btEnd

// ─────────────────────────── ② 模式 2 · RSI 超賣回歸 (S05) — 與主策略 ④c 的設定必須一致 ───────────────────────────
gR2        = "② 模式 2 · RSI 超賣回歸 (與主策略 ④c 保持一致)"
rsiLen     = input.int(14, "RSI 長度", minval = 2, group = gR2, display = display.none)
rsiBuyLv   = input.float(30, "買訊: RSI 上穿此值 (超賣回歸)", minval = 1, maxval = 50, step = 1, group = gR2, display = display.none)
rsiSellMd  = input.string("上穿 中性值 (S05 原版)", "賣訊方式", options = ["上穿 中性值 (S05 原版)", "下穿 超買值 (超買回落)"], group = gR2, tooltip = "務必與主策略 ④c 的同名設定一致, 否則兩個副圖顯示的訊號會對不上。", display = display.none)
rsiExitLv  = input.float(55, "賣訊: 中性值 (RSI 上穿即賣)", minval = 30, maxval = 90, step = 1, group = gR2, display = display.none)
rsiOBLv    = input.float(70, "賣訊: 超買值 (RSI 下穿即賣)", minval = 50, maxval = 99, step = 1, group = gR2, display = display.none)

// ── 門檻與結構 (消化自 cRSI 的動態上下界 與 RSI Swing 的 HH/HL/LH/LL) — 三項設定必須與主策略 ④c 一致 ──
rsiThMd    = input.string("動態: 最近 N 根 RSI 的百分位", "超賣 / 超買門檻怎麼定", options = ["動態: 最近 N 根 RSI 的百分位", "固定: 30 / 70"], group = gR2, display = display.none)
rsiPctLen  = input.int(120, "動態: 取樣根數 N", minval = 20, maxval = 1000, group = gR2, display = display.none)
rsiPctLo   = input.float(10, "動態: 超賣 = 第幾百分位", minval = 1, maxval = 40, step = 1, group = gR2, display = display.none)
rsiPctHi   = input.float(90, "動態: 超買 = 第幾百分位", minval = 60, maxval = 99, step = 1, group = gR2, display = display.none)
rsiStruct  = input.string("需 HL (這次超賣低點高於上次)", "結構過濾 (RSI Swing)", options = ["不過濾", "需 HL (這次超賣低點高於上次)", "需 HL 且 前一個高點 HH"], group = gR2, display = display.none)
// 所有 ta.* 在全域無條件計算 (Pine v6 的 and / or 是短路求值)
rsiV       = ta.rsi(close, rsiLen)
rsiPLo     = ta.percentile_linear_interpolation(rsiV, rsiPctLen, rsiPctLo)
rsiPHi     = ta.percentile_linear_interpolation(rsiV, rsiPctLen, rsiPctHi)
rsiLoBand  = rsiThMd == "固定: 30 / 70" ? rsiBuyLv : nz(rsiPLo, rsiBuyLv)
rsiHiBand  = rsiThMd == "固定: 30 / 70" ? rsiOBLv  : nz(rsiPHi, rsiOBLv)
rsiXupBuy  = ta.crossover(rsiV, rsiLoBand)
rsiXupExit = ta.crossover(rsiV, rsiExitLv)
rsiXdnOB   = ta.crossunder(rsiV, rsiHiBand)
inOS       = rsiV <= rsiLoBand
inOB       = rsiV >= rsiHiBand
var float epLow = na
var float epHigh = na
var float swLow = na
var float prevSwLow = na
var float swHigh = na
var float prevSwHigh = na
var int   epLowBar = na
var int   epHighBar = na
if inOS
    if na(epLow) or low < epLow
        epLowBar := bar_index
    epLow := na(epLow) ? low : math.min(epLow, low)
if inOB
    if na(epHigh) or high > epHigh
        epHighBar := bar_index
    epHigh := na(epHigh) ? high : math.max(epHigh, high)
leftOS = not inOS and inOS[1] and not na(epLow)
leftOB = not inOB and inOB[1] and not na(epHigh)
lowTag  = ""
highTag = ""
if leftOS
    prevSwLow := swLow
    swLow     := epLow
    lowTag    := na(prevSwLow) ? "L" : swLow > prevSwLow ? "HL" : "LL"
    epLow     := na
if leftOB
    prevSwHigh := swHigh
    swHigh     := epHigh
    highTag    := na(prevSwHigh) ? "H" : swHigh > prevSwHigh ? "HH" : "LH"
    epHigh     := na
isHL     = not na(swLow) and not na(prevSwLow) and swLow > prevSwLow
isHH     = not na(swHigh) and not na(prevSwHigh) and swHigh > prevSwHigh
structOK = rsiStruct == "不過濾" ? true : rsiStruct == "需 HL (這次超賣低點高於上次)" ? isHL : (isHL and isHH)
m2BuyRaw = rsiXupBuy
m2Buy    = rsiXupBuy and structOK
m2Sell   = rsiSellMd == "上穿 中性值 (S05 原版)" ? rsiXupExit : rsiXdnOB

// ─────────────────────────── ③ 顯示 ───────────────────────────
gDS        = "③ 顯示"
lwRsi      = input.int(3, "RSI 線粗細", minval = 1, maxval = 6, group = gDS, display = display.none)
showVL     = input.bool(true, "每個買賣訊號畫一條淺灰幼直線 (買 點線 / 賣 虛線)", group = gDS, display = display.none)
vlTransp   = input.int(78, "直線淡化 (透明度 %; 越大越淡)", minval = 30, maxval = 95, step = 2, group = gDS, display = display.none)
showBg     = input.bool(true, "回測期間底色", group = gDS, display = display.none)
showTbl    = input.bool(true, "右上顯示訊號統計", group = gDS, display = display.none)
tblPos     = input.string("右上", "統計表位置", options = ["右上", "右下"], group = gDS, display = display.none)

cBrown     = color.rgb(92, 51, 23)          // 模式 2: 深棕 (粗)
cBuyTri    = color.rgb(120, 180, 255)       // 買訊 ▲ 淺藍
cSellTri   = color.rgb(255, 120, 120)       // 賣訊 ▼ 淺紅

plot(rsiV, "RSI", color = cBrown, linewidth = lwRsi, display = display.pane + display.price_scale)
pLo   = plot(rsiLoBand, "超賣界 (動態或固定)", color = color.new(color.green, 40), linewidth = 1, display = display.pane)
pHi   = plot(rsiHiBand, "超買界 (動態或固定)", color = color.new(color.red, 40), linewidth = 1, display = display.pane)
pMid  = plot(rsiExitLv, "中性值", color = color.new(color.gray, 60), linewidth = 1, display = display.pane)
p0    = plot(0, "0", color = color.new(color.gray, 90), display = display.pane)
p100  = plot(100, "100", color = color.new(color.gray, 90), display = display.pane)
fill(p0, pLo, color = color.new(color.green, 92), title = "超賣區")
fill(pHi, p100, color = color.new(color.red, 92), title = "超買區")
bgcolor(showBg and inWindow ? color.new(color.blue, 94) : na, title = "回測期間底色")

// 訊號直接標在 RSI 曲線上 (label, 最多保留最近 500 個): ▲ 淺藍 = 通過結構過濾的買訊; ▲ 灰小 = 被結構過濾掉的; ▼ 淺紅 = 賣訊
if m2Buy and inWindow
    label.new(bar_index, rsiV, "", style = label.style_triangleup,   color = cBuyTri,  size = size.small, yloc = yloc.price)
if m2BuyRaw and not m2Buy and inWindow
    label.new(bar_index, rsiV, "", style = label.style_triangleup,   color = color.new(color.gray, 40), size = size.tiny, yloc = yloc.price)
if m2Sell and inWindow
    label.new(bar_index, rsiV, "", style = label.style_triangledown, color = cSellTri, size = size.small, yloc = yloc.price)
// 擺動結構標籤: 離開超賣 / 超買區那一根定型, 標在該次極值出現的那根 K 上 (之後不再改, 不重繪)
if leftOS and inWindow
    label.new(epLowBar, rsiLoBand, lowTag, style = label.style_label_up, color = lowTag == "HL" ? color.new(color.green, 20) : color.new(color.gray, 30), textcolor = color.white, size = size.tiny)
if leftOB and inWindow
    label.new(epHighBar, rsiHiBand, highTag, style = label.style_label_down, color = highTag == "HH" ? color.new(color.green, 20) : color.new(color.gray, 30), textcolor = color.white, size = size.tiny)

// 淺灰幼直線: 與主策略同一個視覺語言 (買 點線 / 賣 虛線), 本副圖內貫通上下
vlCol = color.new(color.gray, vlTransp)
if showVL and inWindow and m2Buy
    line.new(bar_index, 0.0, bar_index, 100.0, extend = extend.both, color = vlCol, width = 1, style = line.style_dotted)
if showVL and inWindow and m2Sell
    line.new(bar_index, 0.0, bar_index, 100.0, extend = extend.both, color = vlCol, width = 1, style = line.style_dashed)

// 左側線名標籤 (貼在可見範圍最左那根 K 的 RSI 值上)
var float yRsi = na
if time >= chart.left_visible_bar_time and na(yRsi)
    yRsi := rsiV
var label lbR = na
if barstate.islast
    label.delete(lbR)
    lbR := label.new(chart.left_visible_bar_time, nz(yRsi, rsiV), "模式2 · RSI(" + str.tostring(rsiLen) + ") ▲買(過濾後) ▲灰=被HL過濾 ▼賣 · HL/LL HH/LH=擺動結構", xloc = xloc.bar_time, style = label.style_label_left, color = cBrown, textcolor = color.white, size = size.tiny)

// 訊號統計 (靠右, 與主策略的表格同側)
var int nB = 0
var int nBr = 0
var int nS = 0
if inWindow
    nB  += m2Buy ? 1 : 0
    nBr += m2BuyRaw ? 1 : 0
    nS  += m2Sell ? 1 : 0
posT = tblPos == "右下" ? position.bottom_right : position.top_right
var table tb = table.new(posT, 2, 6, border_width = 1, frame_width = 1, frame_color = color.gray)
if barstate.islast and showTbl
    table.clear(tb, 0, 0, 1, 5)
    hBg = color.new(color.gray, 70)
    table.cell(tb, 0, 0, "模式 2 · RSI 超賣回歸", text_size = size.tiny, text_color = color.white, bgcolor = cBrown)
    table.cell(tb, 1, 0, "RSI " + str.tostring(rsiV, "#.#"), text_size = size.tiny, text_color = color.white, bgcolor = cBrown)
    table.cell(tb, 0, 1, "超賣界 / 超買界", text_size = size.tiny, bgcolor = hBg)
    table.cell(tb, 1, 1, str.tostring(rsiLoBand, "#.#") + " / " + str.tostring(rsiHiBand, "#.#") + (rsiThMd == "固定: 30 / 70" ? " 固定" : " 動態"), text_size = size.tiny)
    table.cell(tb, 0, 4, "買訊 未過濾 → 過濾後", text_size = size.tiny, bgcolor = hBg)
    table.cell(tb, 1, 4, str.tostring(nBr) + " → " + str.tostring(nB), text_size = size.tiny, text_color = color.blue)
    table.cell(tb, 0, 5, "最近結構 低/高", text_size = size.tiny, bgcolor = hBg)
    table.cell(tb, 1, 5, (isHL ? "HL" : na(prevSwLow) ? "-" : "LL") + " / " + (isHH ? "HH" : na(prevSwHigh) ? "-" : "LH"), text_size = size.tiny, text_color = isHL ? color.green : color.gray)
    table.cell(tb, 0, 2, "賣訊 (" + (rsiSellMd == "上穿 中性值 (S05 原版)" ? "上穿 " + str.tostring(rsiExitLv, "#") : "下穿 " + str.tostring(rsiOBLv, "#")) + ")", text_size = size.tiny, bgcolor = hBg)
    table.cell(tb, 1, 2, str.tostring(nS) + " 次", text_size = size.tiny, text_color = color.red)
    table.cell(tb, 0, 3, "窗口", text_size = size.tiny, bgcolor = hBg)
    table.cell(tb, 1, 3, winMode == "最近 N 個交易日" ? str.tostring(tradDays) + " 交易日" : winMode == "最近 N 天 (日曆)" ? str.tostring(lookbackD) + " 天" : "指定日期", text_size = size.tiny)
// ═══ END OF FILE ═══ TV-1M-RSI-mode2_(09月20日; 15:52) · 全檔共 176 行 · 看不到這一行 = 貼上的內容被截斷, 請用「貼上工具」網頁的【複製全部程式碼】 ═══
