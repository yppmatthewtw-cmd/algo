// ═══════════════════════════════════════════════════════════════════════════════
//  TV-1M-winrate-mode4_(09月20日; 14:31)  ·  模式 4 (高勝率閘門) 專用副圖 · 配合主策略 TV-1M-macd-hist,cross&rsi 一起掛
//  規則: 開市向下 → 整天不做; 只做高開或平開 (09:30 開盤 vs 前一日收盤, ±0.3% 內算平開; ② 可切成 09:30→09:50 開盤段方向);
//        可做的日子只在 10:00-10:20 / 10:30-11:00 / 11:50-12:30 / 13:30-14:00 開倉 (② 可改, 紐約時間)
//  顯示: 階梯線 1 = 可開倉 (綠底) / 0.5 = 可做的日子但不在時段 (灰底) / 0 = 開市向下不做 (紅底); 每天開市一個標籤寫當日判定; 右上統計表
//  ② 的三項設定必須與主策略 ④e 一致, 否則兩邊判定會對不上; 這支不下單, 真正的閘門在主策略 ④e 生效 (買入需四模式同時)
//  四處必須一致: 標題 = shorttitle = 檔名 = TradingView 腳本名稱 (結尾的 ")" 不可漏); 本檔共 118 行, 最後一行是 END OF FILE
// ═══════════════════════════════════════════════════════════════════════════════
//@version=6
indicator("TV-1M-winrate-mode4_(09月20日; 14:31)", shorttitle="TV-1M-winrate-mode4_(09月20日; 14:31)", overlay = false, max_labels_count = 500)

// ─────────────────────────── ① 回測期間 / 時段 (與主策略對齊) ───────────────────────────
gBT       = "① 回測期間 / 時段 (與主策略對齊)"
winMode   = input.string("最近 N 天 (日曆)", "回測期間方式", options = ["最近 N 個交易日", "最近 N 天 (日曆)", "指定日期"], group = gBT, display = display.none)
tradDays  = input.int(21, "方式 A · 最近 N 個交易日", minval = 1, maxval = 250, group = gBT, display = display.none)
lookbackD = input.int(30, "方式 B · 最近 N 天 (日曆)", minval = 1, group = gBT, display = display.none)
startIn   = input.time(timestamp("19 Aug 2026 00:00 -0400"), "方式 C · 開始", group = gBT, display = display.none)
endIn     = input.time(timestamp("19 Sep 2026 23:59 -0400"), "方式 C · 結束", group = gBT, display = display.none)
mktPreset = input.string("美股", "市場預設", options = ["美股", "港股", "自訂"], group = gBT, display = display.none)
sessCust  = input.session("0930-1600", "自訂: 交易時段", group = gBT, display = display.none)
tzCust    = input.string("America/New_York", "自訂: 時區", group = gBT, display = display.none)
tzX       = syminfo.timezone
lastDay0  = timestamp(tzX, year(last_bar_time, tzX), month(last_bar_time, tzX), dayofmonth(last_bar_time, tzX), 0, 0, 0)
var int tdStart = na
if na(tdStart)
    ddT = lastDay0
    cntD = 1
    guardD = 0
    while cntD < tradDays and guardD < 400
        ddT -= 86400000
        guardD += 1
        dwD = dayofweek(ddT + 43200000, tzX)
        if dwD != dayofweek.saturday and dwD != dayofweek.sunday
            cntD += 1
    tdStart := ddT
btStart  = winMode == "最近 N 個交易日" ? tdStart : winMode == "最近 N 天 (日曆)" ? timenow - lookbackD * 86400000 : startIn
btEnd    = winMode == "指定日期" ? endIn : timenow
inWindow = time >= btStart and time <= btEnd
sessStr  = mktPreset == "港股" ? "0930-1200,1300-1600" : mktPreset == "美股" ? "0930-1600" : sessCust
tzStr    = mktPreset == "港股" ? "Asia/Hong_Kong" : mktPreset == "美股" ? "America/New_York" : tzCust
isIntra  = timeframe.isintraday
inSess   = not isIntra or not na(time(timeframe.period, sessStr, tzStr))
newSess  = inSess and not inSess[1]

// ─────────────────────────── ② 模式 4 · 高勝率閘門 — 三項設定必須與主策略 ④e 一致 ───────────────────────────
gR4      = "② 模式 4 · 高勝率閘門 (與主策略 ④e 保持一致)"
openDef  = input.string("跳空: 09:30 開盤 vs 前一日收盤", "「開市向下 / 高開 / 平開」的定義", options = ["跳空: 09:30 開盤 vs 前一日收盤", "開盤段: 09:30 → 09:50 方向"], group = gR4, display = display.none)
flatBand = input.float(0.3, "平開的範圍 ±%", minval = 0, step = 0.1, group = gR4, display = display.none)
zoneSess = input.session("1000-1020,1030-1100,1150-1230,1330-1400", "高勝率時段 (紐約時間, 逗號分隔)", group = gR4, display = display.none)

var float dayCloseRun = na
var float prevClose   = na
var float gapPct      = na
var float px0930      = na
var float px0950      = na
if newSess
    prevClose := dayCloseRun
    gapPct    := na(prevClose) or prevClose == 0 ? na : (open - prevClose) / prevClose * 100.0
    px0930    := open
    px0950    := na
if inSess
    dayCloseRun := close
is0950  = isIntra and not na(time(timeframe.period, "0950-0951", tzStr))
if is0950 and na(px0950)
    px0950 := open
drivePct = na(px0950) or na(px0930) or px0930 == 0 ? na : (px0950 - px0930) / px0930 * 100.0
driveOK  = not na(drivePct) and drivePct >= -flatBand
gapOK    = not na(gapPct) and gapPct >= -flatBand
dayOK    = openDef == "跳空: 09:30 開盤 vs 前一日收盤" ? gapOK : driveOK
inZone   = isIntra and not na(time(timeframe.period, zoneSess, tzStr))
gateOn   = inSess and dayOK and inZone
openTxt  = openDef == "跳空: 09:30 開盤 vs 前一日收盤" ? (na(gapPct) ? "跳空 n/a" : (gapPct > flatBand ? "高開 " : gapPct < -flatBand ? "低開 " : "平開 ") + str.tostring(gapPct, "#.##") + "%") : (na(drivePct) ? "開盤段 未定 (等 09:50)" : (drivePct > flatBand ? "開盤上衝 " : drivePct < -flatBand ? "開盤下殺 " : "開盤平 ") + str.tostring(drivePct, "#.##") + "%")

// ─────────────────────────── ③ 顯示: 階梯線 1 = 可開倉 / 0.5 = 可做的日子但不在時段 / 0 = 開市向下整天不做 ───────────────────────────
cOn   = color.rgb(0, 130, 60)
cHalf = color.rgb(150, 150, 150)
cOff  = color.rgb(200, 60, 60)
gateV = not inSess ? na : not dayOK ? 0.0 : inZone ? 1.0 : 0.5
gateC = not dayOK ? cOff : inZone ? cOn : cHalf
plot(gateV, "模式4 閘門 (1 可開倉 / 0.5 不在時段 / 0 不做)", style = plot.style_stepline, linewidth = 3, color = gateC, display = display.pane + display.price_scale)
bgcolor(not inSess ? na : not dayOK ? color.new(cOff, 88) : inZone ? color.new(cOn, 85) : color.new(cHalf, 93), title = "閘門底色")
bgcolor(inWindow ? color.new(color.blue, 96) : na, title = "回測期間底色")
hline(1.0, "可開倉", color = color.new(cOn, 60), linestyle = hline.style_dotted)
hline(0.5, "不在時段", color = color.new(cHalf, 60), linestyle = hline.style_dotted)
hline(0.0, "不做", color = color.new(cOff, 60), linestyle = hline.style_dotted)
// 每天開市在線上標出當日判定
if newSess and inWindow
    label.new(bar_index, dayOK ? 1.05 : -0.05, openTxt + (dayOK ? " → 可做" : " → 不做"), style = dayOK ? label.style_label_down : label.style_label_up, color = dayOK ? color.new(cOn, 20) : color.new(cOff, 20), textcolor = color.white, size = size.tiny)
// 左側線名標籤
var label lbG = na
if barstate.islast
    label.delete(lbG)
    lbG := label.new(chart.left_visible_bar_time, 1.0, "模式4 · 高勝率閘門: 綠 = 可開倉, 灰 = 可做但不在時段, 紅 = 開市向下不做", xloc = xloc.bar_time, style = label.style_label_left, color = color.new(cOn, 30), textcolor = color.white, size = size.tiny)

// ─────────────────────────── ④ 統計表 (靠右) ───────────────────────────
var int nDays  = 0
var int nOK    = 0
var int nBarOn = 0
if newSess and inWindow
    nDays += 1
    nOK   += dayOK ? 1 : 0
if inWindow and gateOn
    nBarOn += 1
var table tb = table.new(position.top_right, 2, 5, border_width = 1, frame_width = 1, frame_color = color.gray)
if barstate.islast
    table.clear(tb, 0, 0, 1, 4)
    hBg = color.new(color.gray, 70)
    table.cell(tb, 0, 0, "模式 4 · 高勝率閘門", text_size = size.tiny, text_color = color.white, bgcolor = cOn)
    table.cell(tb, 1, 0, gateOn ? "現在可開倉" : dayOK ? "今日可做 · 不在時段" : "今日不做", text_size = size.tiny, text_color = color.white, bgcolor = gateOn ? cOn : dayOK ? cHalf : cOff)
    table.cell(tb, 0, 1, "今日開市", text_size = size.tiny, bgcolor = hBg)
    table.cell(tb, 1, 1, openTxt, text_size = size.tiny, text_color = dayOK ? color.green : color.red)
    table.cell(tb, 0, 2, "窗內交易日 / 可做日", text_size = size.tiny, bgcolor = hBg)
    table.cell(tb, 1, 2, str.tostring(nDays) + " / " + str.tostring(nOK), text_size = size.tiny)
    table.cell(tb, 0, 3, "可開倉 K 數", text_size = size.tiny, bgcolor = hBg)
    table.cell(tb, 1, 3, str.tostring(nBarOn), text_size = size.tiny)
    table.cell(tb, 0, 4, "時段", text_size = size.tiny, bgcolor = hBg)
    table.cell(tb, 1, 4, zoneSess, text_size = size.tiny)
// ═══ END OF FILE ═══ TV-1M-winrate-mode4_(09月20日; 14:31) · 全檔共 118 行 · 看不到這一行 = 貼上的內容被截斷, 請用「貼上工具」網頁的【複製全部程式碼】 ═══
