// ═══════════════════════════════════════════════════════════════════════════════
//  TV-1M-RSI-mode2_(09月20日; 21:59)  ·  模式 2 (RSI 14/28 可買區 / 可賣區) 專用副圖 · 配合主策略 TV-1M-dashboard_(mode 1-4) 一起掛
//  模式 2 是「狀態」(像模式 4), 不形成絕對買賣點: 下界 / 上界 = 最近 120 根 RSI14 的第 10 / 90 百分位 (可切固定 30/70)
//  進入可買區 = RSI14 梯度由 ≤0 轉 >0 (谷底在前一根) 且 谷底到達或低於下界; 一直持續直到「昇不上」= RSI14 跌破 RSI28, 或 RSI14 在 RSI28 之下就轉勢向下 (② 可改)
//  進入可賣區 = 相反 (梯度由 ≥0 轉 <0 且 峰頂到達或高於上界), 結束條件相反; 進入另一區直接取代現區; 舊的 cRSI 已全部刪除
//  顯示: 深棕粗線 RSI14 · 橙細線 RSI28 · 綠/紅細線 = 下界/上界 · 底色 淺藍 = 可買區 / 淺紅 = 可賣區 · ▲ 淺藍 = 進可買區 · ▼ 淺紅 = 進可賣區 · × = 區間結束 · 圓點 = 快慢線交叉
//  ② 的 快慢線長度 / 下上界方式 / 百分位 / 到界回看根數 / 區間結束規則 必須與主策略 ④c 一致; 這支不下單; plot 的 title 必須是常數字串
//  四處必須一致: 標題 = shorttitle = 檔名 = TradingView 腳本名稱 (結尾的 ")" 不可漏); 本檔共 203 行, 最後一行是 END OF FILE
// ═══════════════════════════════════════════════════════════════════════════════
//@version=6
indicator("TV-1M-RSI-mode2_(09月20日; 21:59)", shorttitle="TV-1M-RSI-mode2_(09月20日; 21:59)", overlay = false, max_labels_count = 500, max_lines_count = 500)

// ─────────────────────────── ① 回測期間 (與主策略同一套設定, 只用來畫底色) ───────────────────────────
gBT        = "① 回測期間 (與主策略對齊)"
winMode    = input.string("最近 N 天 (日曆)", "回測期間方式 (三選一; 預設一個月)", options = ["最近 N 個交易日", "最近 N 天 (日曆)", "指定日期"], group = gBT, display = display.none)
tradDays   = input.int(21, "方式 A · 最近 N 個交易日", minval = 1, maxval = 250, group = gBT, display = display.none)
lookbackD  = input.int(30, "方式 B · 最近 N 天 (日曆; 30 = 一個月)", minval = 1, group = gBT, display = display.none)
startIn    = input.time(timestamp("19 Aug 2026 00:00 -0400"), "方式 C · 開始日期 (含)", group = gBT, display = display.none)
endIn      = input.time(timestamp("19 Sep 2026 23:59 -0400"), "方式 C · 結束日期 (含)", group = gBT, display = display.none)
tzX        = syminfo.timezone
lastDay0   = timestamp(tzX, year(last_bar_time, tzX), month(last_bar_time, tzX), dayofmonth(last_bar_time, tzX), 0, 0, 0)
var int tdStart = na
if na(tdStart)
    ddT   = lastDay0
    cntD  = 1
    guardD = 0
    while cntD < tradDays and guardD < 400
        ddT    -= 86400000
        guardD += 1
        dwD = dayofweek(ddT + 43200000, tzX)
        if dwD != dayofweek.saturday and dwD != dayofweek.sunday
            cntD += 1
    tdStart := ddT
btStart    = winMode == "最近 N 個交易日" ? tdStart : winMode == "最近 N 天 (日曆)" ? timenow - lookbackD * 86400000 : startIn
btEnd      = winMode == "指定日期" ? endIn : timenow
inWindow   = time >= btStart and time <= btEnd

// ─────────────────────────── ② 模式 2 · RSI 14 / 28 可買區 / 可賣區 (狀態) — 與主策略 ④c 的設定必須一致 ───────────────────────────
gR2        = "② 模式 2 · RSI 14/28 可買區 / 可賣區 (與主策略 ④c 保持一致)"
rsiFastLen = input.int(14, "RSI 快線長度 (轉勢與到界都看它)", minval = 2, group = gR2, tooltip = "務必與主策略 ④c 的同名設定一致, 否則兩個副圖顯示的區間會對不上。", display = display.none)
rsiSlowLen = input.int(28, "RSI 慢線長度 (與快線比較交叉; 決定區間何時結束)", minval = 2, group = gR2, display = display.none)
rsiBandMd  = input.string("動態: 最近 N 根 RSI14 的百分位", "下界 / 上界怎麼定", options = ["動態: 最近 N 根 RSI14 的百分位", "固定: 30 / 70"], group = gR2, display = display.none)
rsiPctLen  = input.int(120, "動態: 取樣根數 N", minval = 20, maxval = 1000, group = gR2, display = display.none)
rsiPctLo   = input.float(10, "動態: 下界 = 第幾百分位", minval = 1, maxval = 40, step = 1, group = gR2, display = display.none)
rsiPctHi   = input.float(90, "動態: 上界 = 第幾百分位", minval = 60, maxval = 99, step = 1, group = gR2, display = display.none)
rsiFixLo   = input.float(30, "固定: 下界", minval = 1, maxval = 50, step = 1, group = gR2, display = display.none)
rsiFixHi   = input.float(70, "固定: 上界", minval = 50, maxval = 99, step = 1, group = gR2, display = display.none)
m2Reach    = input.int(1, "轉勢前幾根內曾到達 / 超過該界才算 (1 = 轉勢那根的谷底 / 峰頂本身要在界外)", minval = 1, maxval = 10, group = gR2, display = display.none)
m2ResetDay = input.bool(true, "每個交易日開始時清空區間 (與主策略 ④c 一致)", group = gR2, display = display.none)
zoneEndMd  = input.string("RSI14 跌破 RSI28, 或 RSI14 跌破進區時的谷底 (反彈失敗 = 昇不上)", "可買區何時結束 (可賣區用相反條件)", options = ["RSI14 跌破 RSI28, 或 RSI14 跌破進區時的谷底 (反彈失敗 = 昇不上)", "RSI14 轉勢向下 (梯度轉負)", "RSI28 轉勢向下 (梯度轉負)"], group = gR2, display = display.none)
// 全部 ta.* 在全域無條件計算 (Pine v6 的 and / or 是短路求值)
rsiF       = ta.rsi(close, rsiFastLen)
rsiS       = ta.rsi(close, rsiSlowLen)
rsiPLo     = ta.percentile_linear_interpolation(rsiF, rsiPctLen, rsiPctLo)
rsiPHi     = ta.percentile_linear_interpolation(rsiF, rsiPctLen, rsiPctHi)
rsiLoBand  = rsiBandMd == "固定: 30 / 70" ? rsiFixLo : nz(rsiPLo, rsiFixLo)
rsiHiBand  = rsiBandMd == "固定: 30 / 70" ? rsiFixHi : nz(rsiPHi, rsiFixHi)
turnUpF    = rsiF > rsiF[1] and rsiF[1] <= rsiF[2]     // RSI14 梯度由 ≤0 轉 >0 (谷底在前一根, 本根收盤確認, 不重繪)
turnDnF    = rsiF < rsiF[1] and rsiF[1] >= rsiF[2]
turnUpS    = rsiS > rsiS[1] and rsiS[1] <= rsiS[2]
turnDnS    = rsiS < rsiS[1] and rsiS[1] >= rsiS[2]
sinceLoF   = ta.barssince(rsiF <= rsiLoBand)
sinceHiF   = ta.barssince(rsiF >= rsiHiBand)
reachLoF   = nz(sinceLoF[1], 99999) < m2Reach
reachHiF   = nz(sinceHiF[1], 99999) < m2Reach
xFSdn      = ta.crossunder(rsiF, rsiS)                 // 快線跌破慢線
xFSup      = ta.crossover(rsiF, rsiS)                  // 快線升穿慢線
m2BuyStart  = turnUpF and reachLoF                     // 進入可買區
m2SellStart = turnDnF and reachHiF                     // 進入可賣區
endModeA   = zoneEndMd == "RSI14 跌破 RSI28, 或 RSI14 跌破進區時的谷底 (反彈失敗 = 昇不上)"
endModeB   = zoneEndMd == "RSI14 轉勢向下 (梯度轉負)"
var int   m2State  = 0                                 // 1 = 可買區, -1 = 可賣區, 0 = 無
var float m2Trough = na                                // 進入可買區那一根的谷底 (RSI14 值)
var float m2Peak   = na                                // 進入可賣區那一根的峰頂
buyEndRaw  = endModeA ? (xFSdn or rsiF < m2Trough) : endModeB ? turnDnF : turnDnS   // 「昇不上」: 跌破慢線 或 跌破進區谷底
sellEndRaw = endModeA ? (xFSup or rsiF > m2Peak)   : endModeB ? turnUpF : turnUpS   // 相反: 「跌不下」
newDay     = dayofmonth != dayofmonth[1]
if m2ResetDay and newDay
    m2State := 0
m2Prev     = m2State
if m2BuyStart                                          // 進入新區優先於現區結束
    m2State  := 1
    m2Trough := rsiF[1]
else if m2SellStart
    m2State := -1
    m2Peak  := rsiF[1]
else if m2State == 1 and buyEndRaw
    m2State := 0
else if m2State == -1 and sellEndRaw
    m2State := 0
m2InBuy    = m2State == 1
m2InSell   = m2State == -1
m2BuyEnd   = m2Prev == 1 and not m2InBuy
m2SellEnd  = m2Prev == -1 and not m2InSell
m2BuyRaw   = turnUpF
m2SellRaw  = turnDnF
m2Zone     = m2InBuy ? "可買區" : m2InSell ? "可賣區" : "無"

// ─────────────────────────── ③ 顯示 ───────────────────────────
gDS        = "③ 顯示"
lwRsi      = input.int(3, "RSI14 線粗細", minval = 1, maxval = 6, group = gDS, display = display.none)
showRaw    = input.bool(false, "顯示未到界的轉勢 (灰色小三角, 只供對照; 預設關)", group = gDS, display = display.none)
showX      = input.bool(true, "標出 RSI14 / RSI28 的交叉 (小圓點: 升穿 藍 / 跌破 紅)", group = gDS, display = display.none)
showVL     = input.bool(true, "進入可買 / 可賣區那一根畫一條淺灰幼直線 (買 點線 / 賣 虛線)", group = gDS, display = display.none)
vlTransp   = input.int(78, "直線淡化 (透明度 %; 越大越淡)", minval = 30, maxval = 95, step = 2, group = gDS, display = display.none)
showBg     = input.bool(true, "區間底色 (可買區 淺藍 / 可賣區 淺紅) + 回測期間底色", group = gDS, display = display.none)
showTbl    = input.bool(true, "右上顯示訊號統計", group = gDS, display = display.none)
tblPos     = input.string("右上", "統計表位置", options = ["右上", "右下"], group = gDS, display = display.none)

cBrown     = color.rgb(92, 51, 23)          // 模式 2: 深棕 (粗) = RSI14
cSlow      = color.rgb(200, 120, 0)         // RSI28: 橙 (細)
cBuyTri    = color.rgb(120, 180, 255)       // 進入可買區 ▲ 淺藍
cSellTri   = color.rgb(255, 120, 120)       // 進入可賣區 ▼ 淺紅
cBuyZone   = color.new(color.rgb(60, 140, 255), 85)
cSellZone  = color.new(color.rgb(255, 80, 80), 88)

plot(rsiF, "RSI14 (快)", color = cBrown, linewidth = lwRsi, display = display.pane + display.price_scale)
plot(rsiS, "RSI28 (慢)", color = cSlow, linewidth = 1, display = display.pane + display.price_scale)
pLo   = plot(rsiLoBand, "下界 (lower band)", color = color.new(color.green, 40), linewidth = 1, display = display.pane)
pHi   = plot(rsiHiBand, "上界 (upper band)", color = color.new(color.red, 40), linewidth = 1, display = display.pane)
p0    = plot(0, "0", color = color.new(color.gray, 90), display = display.pane)
p100  = plot(100, "100", color = color.new(color.gray, 90), display = display.pane)
fill(p0, pLo, color = color.new(color.green, 92), title = "下界以下")
fill(pHi, p100, color = color.new(color.red, 92), title = "上界以上")
bgcolor(showBg and m2InBuy ? cBuyZone : showBg and m2InSell ? cSellZone : na, title = "可買區 / 可賣區 底色")
bgcolor(showBg and inWindow ? color.new(color.blue, 96) : na, title = "回測期間底色")

// 進入區間那一根標在 RSI14 上: ▲ 淺藍 = 進入可買區 (到下界後轉勢向上); ▼ 淺紅 = 進入可賣區 (到上界後轉勢向下); 區間結束 = 小叉 (plotshape, 不佔 label 上限 500)
if m2BuyStart and inWindow
    label.new(bar_index, rsiF, "", style = label.style_triangleup,   color = cBuyTri,  size = size.small, yloc = yloc.price)
if m2SellStart and inWindow
    label.new(bar_index, rsiF, "", style = label.style_triangledown, color = cSellTri, size = size.small, yloc = yloc.price)
plotshape(m2BuyEnd  and inWindow ? rsiF : na, "可買區結束 ×", style = shape.xcross, location = location.absolute, color = color.new(color.blue, 30), size = size.tiny, display = display.pane)
plotshape(m2SellEnd and inWindow ? rsiF : na, "可賣區結束 ×", style = shape.xcross, location = location.absolute, color = color.new(color.red, 30),  size = size.tiny, display = display.pane)
if showRaw and m2BuyRaw and not m2BuyStart and inWindow
    label.new(bar_index, rsiF, "", style = label.style_triangleup,   color = color.new(color.gray, 55), size = size.tiny, yloc = yloc.price)
if showRaw and m2SellRaw and not m2SellStart and inWindow
    label.new(bar_index, rsiF, "", style = label.style_triangledown, color = color.new(color.gray, 55), size = size.tiny, yloc = yloc.price)
// RSI14 / RSI28 交叉: 小圓點 (比較快慢線的交叉情況)
plotshape(showX and xFSup and inWindow ? rsiS : na, "RSI14 升穿 RSI28", style = shape.circle, location = location.absolute, color = color.new(color.blue, 20), size = size.tiny, display = display.pane)
plotshape(showX and xFSdn and inWindow ? rsiS : na, "RSI14 跌破 RSI28", style = shape.circle, location = location.absolute, color = color.new(color.red, 20),  size = size.tiny, display = display.pane)

// 淺灰幼直線: 與主策略同一個視覺語言 (買 點線 / 賣 虛線), 本副圖內貫通上下
vlCol = color.new(color.gray, vlTransp)
if showVL and inWindow and m2BuyStart
    line.new(bar_index, 0.0, bar_index, 100.0, extend = extend.both, color = vlCol, width = 1, style = line.style_dotted)
if showVL and inWindow and m2SellStart
    line.new(bar_index, 0.0, bar_index, 100.0, extend = extend.both, color = vlCol, width = 1, style = line.style_dashed)

// 左側線名標籤 (貼在可見範圍最左那根 K 的數值上)
var float yF = na
var float yS = na
if time >= chart.left_visible_bar_time and na(yF)
    yF := rsiF
    yS := rsiS
var label lbF = na
var label lbS = na
if barstate.islast
    label.delete(lbF)
    label.delete(lbS)
    lbF := label.new(chart.left_visible_bar_time, nz(yF, rsiF), "模式2 · RSI" + str.tostring(rsiFastLen) + " ▲進可買區=到下界後轉勢向上 ▼進可賣區=到上界後轉勢向下 · 底色=區間", xloc = xloc.bar_time, style = label.style_label_left, color = cBrown, textcolor = color.white, size = size.tiny)
    lbS := label.new(chart.left_visible_bar_time, nz(yS, rsiS), "RSI" + str.tostring(rsiSlowLen) + " (慢) · 圓點=快慢線交叉", xloc = xloc.bar_time, style = label.style_label_left, color = cSlow, textcolor = color.white, size = size.tiny)

// 訊號統計 (靠右, 與主策略的表格同側)
var int nB = 0
var int nBr = 0
var int nS = 0
var int nSr = 0
var int nBarB = 0
var int nBarS = 0
var int nBarAll = 0
var int nXup = 0
var int nXdn = 0
if inWindow
    nB   += m2BuyStart ? 1 : 0
    nBr  += m2BuyRaw ? 1 : 0
    nS   += m2SellStart ? 1 : 0
    nSr  += m2SellRaw ? 1 : 0
    nBarB += m2InBuy ? 1 : 0
    nBarS += m2InSell ? 1 : 0
    nBarAll += 1
    nXup += xFSup ? 1 : 0
    nXdn += xFSdn ? 1 : 0
posT = tblPos == "右下" ? position.bottom_right : position.top_right
var table tb = table.new(posT, 2, 7, border_width = 1, frame_width = 1, frame_color = color.gray)
if barstate.islast and showTbl
    table.clear(tb, 0, 0, 1, 6)
    hBg = color.new(color.gray, 70)
    table.cell(tb, 0, 0, "模式 2 · RSI " + str.tostring(rsiFastLen) + "/" + str.tostring(rsiSlowLen) + " 可買區 / 可賣區", text_size = size.tiny, text_color = color.white, bgcolor = cBrown)
    table.cell(tb, 1, 0, "現況 " + m2Zone, text_size = size.tiny, text_color = color.white, bgcolor = m2InBuy ? color.rgb(40, 110, 220) : m2InSell ? color.rgb(200, 60, 60) : cBrown)
    table.cell(tb, 0, 1, "RSI14 / RSI28", text_size = size.tiny, bgcolor = hBg)
    table.cell(tb, 1, 1, str.tostring(rsiF, "#.#") + " / " + str.tostring(rsiS, "#.#") + (rsiF > rsiS ? "  快>慢" : rsiF < rsiS ? "  快<慢" : "  快=慢"), text_size = size.tiny)
    table.cell(tb, 0, 2, "下界 / 上界", text_size = size.tiny, bgcolor = hBg)
    table.cell(tb, 1, 2, str.tostring(rsiLoBand, "#.#") + " / " + str.tostring(rsiHiBand, "#.#") + (rsiBandMd == "固定: 30 / 70" ? " 固定" : " 動態 P" + str.tostring(rsiPctLo, "#") + "/P" + str.tostring(rsiPctHi, "#")), text_size = size.tiny)
    table.cell(tb, 0, 3, "進可買區: 轉勢向上 → 到下界才算", text_size = size.tiny, bgcolor = hBg)
    table.cell(tb, 1, 3, str.tostring(nBr) + " → " + str.tostring(nB) + " 次", text_size = size.tiny, text_color = color.blue)
    table.cell(tb, 0, 4, "進可賣區: 轉勢向下 → 到上界才算", text_size = size.tiny, bgcolor = hBg)
    table.cell(tb, 1, 4, str.tostring(nSr) + " → " + str.tostring(nS) + " 次", text_size = size.tiny, text_color = color.red)
    table.cell(tb, 0, 5, "窗內 K 數: 可買區 / 可賣區 / 全部", text_size = size.tiny, bgcolor = hBg)
    table.cell(tb, 1, 5, str.tostring(nBarB) + " / " + str.tostring(nBarS) + " / " + str.tostring(nBarAll) + "  (可買區 " + str.tostring(nBarAll > 0 ? nBarB * 100.0 / nBarAll : 0.0, "#") + "%)", text_size = size.tiny)
    table.cell(tb, 0, 6, "快慢線交叉 升穿 / 跌破 · 區間結束規則", text_size = size.tiny, bgcolor = hBg)
    table.cell(tb, 1, 6, str.tostring(nXup) + " / " + str.tostring(nXdn) + " · " + (endModeA ? "跌破慢線或跌破進區谷底" : endModeB ? "RSI14 轉勢" : "RSI28 轉勢"), text_size = size.tiny)
// ═══ END OF FILE ═══ TV-1M-RSI-mode2_(09月20日; 21:59) · 全檔共 203 行 · 看不到這一行 = 貼上的內容被截斷, 請用「貼上工具」網頁的【複製全部程式碼】 ═══
