// ═══════════════════════════════════════════════════════════════════════════════
//  TW-1M-MACD-(09月19日_18:14)  ·  MACD 動能蓄積交叉策略 · 1 分鐘回測版 (市場預設 美股, ⑤ 可一鍵切港股) · TradingView Pine Script v6
//  四處必須一致: strategy() 標題 = shorttitle = 檔名 = TradingView 腳本名稱 (Save 時輸入; 結尾的 ")" 不可漏)
//  本檔共 395 行; 最後一行是 "// ═══ END OF FILE ═══" → 貼上後若看不到那一行 = 內容被截斷 (檔案預覽視窗常只載入前 8KB)
//  正確貼法: 用「貼上工具」網頁按【複製全部程式碼】, 或下載 .pine 後用純文字編輯器開啟 → Ctrl+A → Ctrl+C
//
//  【本版關鍵參數 — 目標: 平均每日 5 筆交易】
//   ★ margin_long = 0, margin_short = 0   ← 修正 0 交易的真正原因: Pine v6 預設 margin 100%, 「全部本金」下單加上手續費/滑點會被拒
//   ★ 自動校準 目標每日交易次數 = 5       ← 每個交易日收盤結算昨日成交筆數, 低於目標×0.8 門檻係數 k 降 20%, 高於目標×1.3 升 20%
//   ★ 深度門檻百分位 60 → 50, 最少連續根數 4 → 3, 面積係數 0.6 → 0.5   ← 起始門檻先降一級, 再由自動校準逐日收斂
//   報表「門檻(現值)」列會顯示現行 k 值與近日均交易數; 手動模式或把目標設 0 即關閉校準
//
//  規則: 買 = 負動能段「儲夠」後 DIF 上穿 DEA (收盤確認) → 下一根開盤買; 賣 = 正動能段儲夠後 DIF 下穿 DEA → 下一根開盤賣
//        儲夠 = 同號柱連續根數 ≥ minBars 且 面積 Σ|hist|/close% ≥ minArea 且 深度 max|hist|/close% ≥ minDepth; 長倉 only
//  預設: 本金 100,000 · 最近 30 天 · 美股時段 09:30-16:00 America/New_York (DST 自動) · 15:45 後不開新倉 · 15:58 強制平倉
//  圖示 (主圖與副圖同步): ▲藍三角+藍直線 = 買單真正成交那一根 (訊號K的下一根開盤); ▼紅三角+紅直線 = 賣單成交; 幼點線貫通主圖與 MACD 副圖
//        橙框 = 持倉期間: 主圖框住該段價格 K 線, 副圖框住該段 MACD 柱 (force_overlay 把繪圖送到主圖, 策略本身仍在副圖)
//  版面: 回測摘要 + 逐筆交易表 → 主圖 (⑦ 可選位置); 副圖只留「觸發參數」表: 門檻現值 / 現段統計 / 交叉→合格漏斗 / 勝率, 調 ④ 即時看效果
//        兩表預設同靠右上, 直線對齊; 成交直線為幼點線 (width 1, dotted), 淡化程度由 ⑧ lineTransp 調 (預設 55%)
//  報表: 期內交易次數 / 每筆 P&L ($ 與 %) / 整段 Total P&L / 每日平均交易次數; 時段或時區設錯會直接指出
//  注意: TradingView 的 MACD 柱 = DIF−DEA (牛牛/Webull 顯示 2×), 門檻以 1× 定義; 手續費/滑點務必填真實值, 填 0 會嚴重高估
//  使用: 圖表週期切【1 分鐘】→ Pine Editor 貼上 → 檢查最後一行 → Save (輸入同名) → Add to chart → Strategy Tester
//  版本戳 (MM月DD日_HH:MM) = 建置時間 HKT; 檔名以 . 代替 : (Windows 檔名不接受冒號); 本檔零延續行, 每個語句自成一行
// ═══════════════════════════════════════════════════════════════════════════════
//@version=6
strategy("TW-1M-MACD-(09月19日_18:14)", shorttitle="TW-1M-MACD-(09月19日_18:14)", overlay=false, initial_capital = 100000, margin_long = 0, margin_short = 0, default_qty_type = strategy.percent_of_equity, default_qty_value = 100, commission_type = strategy.commission.percent, commission_value = 0.03, slippage = 2, process_orders_on_close = false, calc_on_every_tick = false, pyramiding = 0, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ─────────────────────────── ① 回測期間 (預設最近 30 天) ───────────────────────────
gBT        = "① 回測期間"
useRolling = input.bool(true,  "用「最近 N 天」(取消勾選則用下方指定日期)", group = gBT)
lookbackD  = input.int(30,     "回測天數 (1分K建議 10-60 天)", minval = 1, group = gBT, tooltip = "1分K可載入的根數受 TradingView 方案限制 (免費約5000根 ≈ 15個港股交易日)。設得比圖表能載入的更長, 只會回測到圖表最左邊那一根為止。")
startIn    = input.time(timestamp("01 Jan 2025 00:00 +0800"), "開始日期", group = gBT)
endIn      = input.time(timestamp("31 Dec 2025 23:59 +0800"), "結束日期", group = gBT)
btStart    = useRolling ? timenow - lookbackD * 86400000 : startIn
btEnd      = useRolling ? timenow : endIn
inWindow   = time >= btStart and time <= btEnd

// ─────────────────────────── ② 資金 / 下單金額 ───────────────────────────
gSZ       = "② 資金"
sizeMode  = input.string("全部本金", "每筆下單金額", options = ["全部本金", "固定金額", "固定股數"], group = gSZ)
fixedCash = input.float(100000, "固定金額", step = 1000, group = gSZ)
fixedQty  = input.float(1000,   "固定股數", step = 100,  group = gSZ)
// ※ 本金 100,000 寫在 strategy() 的 initial_capital; 亦可在 設定→Properties→Initial capital 改

// ─────────────────────────── ③ MACD ───────────────────────────
gM      = "③ MACD"
fastLen = input.int(12, "快線 EMA", minval = 1, group = gM)
slowLen = input.int(26, "慢線 EMA", minval = 1, group = gM)
sigLen  = input.int(9,  "訊號線 (移動平均週期)", minval = 1, group = gM)

[dif, dea, hist] = ta.macd(close, fastLen, slowLen, sigLen)
histPct = hist / close * 100.0
sgn     = hist > 0 ? 1 : hist < 0 ? -1 : 0

// ─────────────────────────── ④ 動能蓄積門檻 ───────────────────────────
gTH        = "④ 動能蓄積門檻"
thMode     = input.string("自動(百分位)", "門檻模式", options = ["自動(百分位)", "手動"], group = gTH, tooltip = "自動: 以近N根柱高分佈自動定門檻, 換週期/換標的免手調。手動: 自己填死數。")
minBars    = input.int(3, "動能段最少連續根數 (本版 3; 舊版 4)", minval = 1, group = gTH)
pctLen     = input.int(250, "自動模式取樣根數", minval = 30, group = gTH)
depthPctl  = input.float(50, "自動: 深度門檻取第幾百分位 (本版 50; 舊版 60)", minval = 1, maxval = 99, step = 5, group = gTH)
areaFactor = input.float(0.5, "自動: 面積係數 (面積門檻 = 深度 × 根數 × 係數; 本版 0.5)", step = 0.1, group = gTH)
minDepthIn = input.float(0.35, "手動: 深度門檻 max|hist|/close (%)", step = 0.05, group = gTH)
minAreaIn  = input.float(1.20, "手動: 面積門檻 Σ|hist|/close (%·根)", step = 0.1, group = gTH)

autoDepth = ta.percentile_linear_interpolation(math.abs(histPct), pctLen, depthPctl)

// ─── ④b 自動校準: 以「目標每日交易次數」逐日調整門檻係數 k (只用已完成的交易日結算, 無前視) ───
targetTPD = input.float(5, "自動校準: 目標每日交易次數 (0 = 關閉)", minval = 0, step = 1, group = gTH, tooltip = "每個新交易日開始時結算「昨日」成交筆數 (以 0.5 權重平滑): 低於目標×0.8 → 門檻係數 k 降一級; 高於目標×1.3 → k 升一級。k 乘在自動深度門檻上, 面積門檻隨之連動。手動模式不受影響。")
calStep   = input.float(20, "自動校準: 每級調整幅度 %", minval = 5, maxval = 50, step = 5, group = gTH)
var float kEff       = 1.0     // 現行門檻係數
var int   ctDayStart = 0       // 今日開始時的累計成交筆數
var float tpdEMA     = na      // 近日每日成交筆數 (平滑)
newDay = dayofmonth != dayofmonth[1]
if newDay and inWindow
    nYest = strategy.closedtrades - ctDayStart
    ctDayStart := strategy.closedtrades
    if inWindow[1]
        tpdEMA := na(tpdEMA) ? nYest : 0.5 * tpdEMA + 0.5 * nYest
        if targetTPD > 0 and thMode != "手動"
            if tpdEMA < targetTPD * 0.8
                kEff := math.max(0.1, kEff * (1.0 - calStep / 100.0))
            else if tpdEMA > targetTPD * 1.3
                kEff := math.min(5.0, kEff * (1.0 + calStep / 100.0))

minDepth  = thMode == "手動" ? minDepthIn : autoDepth * kEff
minArea   = thMode == "手動" ? minAreaIn  : minDepth * minBars * areaFactor

// ─────────────────────────── ⑤ 顯示 ───────────────────────────
gDS            = "⑧ 顯示"
showHoldBox    = input.bool(true,  "橙框: 持倉期間框住 MACD 柱", group = gDS)
showFillMarks  = input.bool(true,  "三角形 + 直線: 只在真正成交時畫", group = gDS)
lineTransp     = input.int(55, "成交直線淡化 (透明度 %; 越大越淡)", minval = 0, maxval = 90, step = 5, group = gDS)
showClusterBox = input.bool(false, "對照用: 合格動能段框 (舊版行為)", group = gDS, tooltip = "打開會另外畫出「儲夠動能」的柱群框 — 注意那是訊號條件, 不代表有成交。")

// ─────────────────────────── ⑥ 同號柱段統計 (只用已完成K, 無前視) ───────────────────────────
var int   curSign  = 0
var int   curBars  = 0
var float curArea  = 0.0
var float curDepth = 0.0
var int   curStart = na

crossUp = ta.crossover(dif, dea)
crossDn = ta.crossunder(dif, dea)
// 交叉發生在本K → 「剛結束的段」= 上一根為止的統計 (先評估, 後更新)
prevOK  = curBars >= minBars and curArea >= minArea and curDepth >= minDepth
negOK   = curSign == -1 and prevOK
posOK   = curSign ==  1 and prevOK
buySig  = crossUp and negOK
sellSig = crossDn and posOK

// 合格動能段框 — 預設關閉。這是「訊號條件」, 不代表有成交, 只作對照用
if showClusterBox and buySig and inWindow
    box.new(curStart, 0.0, bar_index - 1, -curDepth * close / 100.0 * 1.15, border_color = color.new(color.aqua, 55), bgcolor = color.new(color.aqua, 93), border_width = 1)
if showClusterBox and sellSig and inWindow
    box.new(curStart, 0.0, bar_index - 1, curDepth * close / 100.0 * 1.15, border_color = color.new(color.orange, 55), bgcolor = color.new(color.orange, 93), border_width = 1)

// 更新段統計
if sgn != 0 and sgn != curSign
    curSign  := sgn
    curBars  := 1
    curArea  := math.abs(histPct)
    curDepth := math.abs(histPct)
    curStart := bar_index
else if sgn != 0
    curBars  += 1
    curArea  += math.abs(histPct)
    curDepth := math.max(curDepth, math.abs(histPct))

// ─────────────────────────── ⑦ 盤中時段 (本版核心: 全部啟用) ───────────────────────────
gS        = "⑤ 盤中時段"
mktPreset = input.string("美股", "市場預設 (一鍵套用時段+時區)", options = ["美股", "港股", "自訂"], group = gS, tooltip = "美股 = 0930-1600 · America/New_York (無午休, 夏令時間自動處理)\n港股 = 0930-1200,1300-1600 · Asia/Hong_Kong (有午休)\n自訂 = 用下面兩欄自己填\n\n※ 時段/時區與商品不符 → 一根K都不算在盤中 → 一張單都不會成交。報表會直接指出。")
sessCust  = input.session("0930-1600", "自訂: 交易時段", group = gS)
tzCust    = input.string("America/New_York", "自訂: 時區", group = gS)
noEntry   = input.session("1545-1600", "收市前不開新倉時段", group = gS)
eodSess   = input.session("1558-1600", "強制平倉時段 (不留隔夜倉)", group = gS)

sessStr   = mktPreset == "港股" ? "0930-1200,1300-1600" : mktPreset == "美股" ? "0930-1600" : sessCust
tzStr     = mktPreset == "港股" ? "Asia/Hong_Kong"      : mktPreset == "美股" ? "America/New_York" : tzCust

isIntra   = timeframe.isintraday
inSess    = not isIntra or not na(time(timeframe.period, sessStr, tzStr))
blockNew  = isIntra and not na(time(timeframe.period, noEntry, tzStr))
eodBar    = isIntra and not na(time(timeframe.period, eodSess, tzStr))
tzMatch   = tzStr == syminfo.timezone   // 策略時區 vs 此商品交易所時區

// ─────────────────────────── ⑧ 風控 ───────────────────────────
gR      = "⑥ 風控"
useStop = input.bool(false, "啟用固定止損 (原題不設)", group = gR)
stopPct = input.float(1.0, "止損 % (1分鐘刻度; 日線版用 5%)", step = 0.1, group = gR)

// ─────────────────────────── ⑨ 下單 ───────────────────────────
qty     = sizeMode == "全部本金" ? strategy.equity / close : sizeMode == "固定金額" ? fixedCash / close : fixedQty
entryOK = inWindow and inSess and not blockNew and not eodBar

if buySig and entryOK and strategy.position_size == 0
    if sizeMode == "全部本金"
        strategy.entry("L", strategy.long, comment = "BUY")          // 用 default_qty_type=percent_of_equity 100%
    else
        strategy.entry("L", strategy.long, qty = qty, comment = "BUY")
if sellSig and strategy.position_size > 0
    strategy.close("L", comment = "SELL")
if useStop and strategy.position_size > 0
    strategy.exit("SL", "L", stop = strategy.position_avg_price * (1 - stopPct / 100.0))
if eodBar and strategy.position_size != 0
    strategy.close_all(comment = "EOD")
// 回測窗結束 → 平掉未平倉, 讓報表數字對應完整期間
if not inWindow and strategy.position_size != 0
    strategy.close_all(comment = "窗口結束")

// ─────────────────────────── ⑩ 成交偵測: 只有真正成交才畫標記 ───────────────────────────
// strategy.position_size 在「訂單成交那一根」才改變 (訂單於下一根開盤成交)
// → 這兩個旗標代表【真正成交】, 而非單純出現訊號:
//    已有倉時的買訊 / 無倉時的賣訊 / 回測窗外的訊號 → position_size 不變 → 不會畫
posSz      = strategy.position_size
justFilled = posSz > 0  and posSz[1] <= 0      // 買單真正成交
justClosed = posSz <= 0 and posSz[1] >  0      // 賣單真正成交 (含 MACD賣訊 / 止損 / 窗口結束)

// 成交直線
// 成交直線: 副圖 (MACD) 一條 + 主圖 (價格 K 線) 一條, 兩條同一根 K, 上下貫通
// 直線樣式: 幼 (width 1) · 點線 · 淡色 (透明度由 ⑧ lineTransp 控制), 主圖與副圖一致
if showFillMarks and justFilled
    line.new(bar_index, hist, bar_index, 0.0, extend = extend.both, color = color.new(color.aqua, lineTransp), width = 1, style = line.style_dotted)
    line.new(bar_index, low, bar_index, high, extend = extend.both, color = color.new(color.aqua, lineTransp), width = 1, style = line.style_dotted, force_overlay = true)
if showFillMarks and justClosed
    line.new(bar_index, hist, bar_index, 0.0, extend = extend.both, color = color.new(color.red, lineTransp), width = 1, style = line.style_dotted)
    line.new(bar_index, low, bar_index, high, extend = extend.both, color = color.new(color.red, lineTransp), width = 1, style = line.style_dotted, force_overlay = true)

// 持倉期間橙框: 進場成交K → 出場成交K, 高度包住該段 MACD 柱; 仍持倉則跟著最新K延伸
var box   hBox  = na    // 副圖: 框住持倉期間的 MACD 柱
var float hHi   = na
var float hLo   = na
var box   hBoxP = na    // 主圖: 框住持倉期間的價格 K 線 (同一段時間)
var float pHi   = na
var float pLo   = na
if showHoldBox and justFilled
    hHi  := hist
    hLo  := hist
    hBox := box.new(bar_index, hist, bar_index, hist, border_color = color.new(color.orange, 0), bgcolor = color.new(color.orange, 90), border_width = 2)
    pHi  := high
    pLo  := low
    hBoxP := box.new(bar_index, high, bar_index, low, border_color = color.new(color.orange, 0), bgcolor = color.new(color.orange, 85), border_width = 2, force_overlay = true)
if not na(hBox) and (posSz > 0 or justClosed)
    hHi := math.max(hHi, hist)
    hLo := math.min(hLo, hist)
    pad = math.max((hHi - hLo) * 0.15, math.max(math.abs(hHi), math.abs(hLo)) * 0.20)
    box.set_right(hBox, bar_index)
    box.set_top(hBox, hHi + pad)
    box.set_bottom(hBox, hLo - pad)
if not na(hBoxP) and (posSz > 0 or justClosed)
    pHi := math.max(pHi, high)
    pLo := math.min(pLo, low)
    padP = (pHi - pLo) * 0.08
    box.set_right(hBoxP, bar_index)
    box.set_top(hBoxP, pHi + padP)
    box.set_bottom(hBoxP, pLo - padP)
if justClosed
    hBox  := na
    hBoxP := na

// ─────────────────────────── ⑪ 盤中統計 (交易日數 / 在市場時間 / 週期檢查) ───────────────────────────
var int nDays   = 0     // 回測窗內的交易日數
var int barsTot = 0     // 窗內可交易K數
var int barsIn  = 0     // 其中持倉的K數
if inWindow and dayofmonth != dayofmonth[1]
    nDays += 1
if inWindow and inSess
    barsTot += 1
    if strategy.position_size != 0
        barsIn += 1
tfOK = timeframe.period == "1"   // 本策略為 1 分鐘設計; 貼到其他週期會在報表警告

// ─────────────────────────── ⑫ 繪圖 ───────────────────────────
plot(hist, "Histogram", style = plot.style_columns, color = hist >= 0 ? (hist >= hist[1] ? color.new(color.green, 0) : color.new(color.green, 45)) : (hist <= hist[1] ? color.new(color.red, 0)   : color.new(color.red, 45)))
plot(dif, "DIF", color = color.new(color.orange, 0), linewidth = 2)
plot(dea, "DEA", color = color.new(color.aqua, 0), linewidth = 1)
hline(0)
bgcolor(inWindow ? color.new(color.blue, 94) : na, title = "回測期間底色")
plotshape(showFillMarks and justFilled, "買入成交", style = shape.triangleup,   location = location.bottom, color = color.new(color.aqua, 0), size = size.small, text = "B")
plotshape(showFillMarks and justClosed, "賣出成交", style = shape.triangledown, location = location.top,    color = color.new(color.red, 0),  size = size.small, text = "S")
plotshape(showFillMarks and justFilled, "買入成交(主圖)", style = shape.triangleup,   location = location.belowbar, color = color.new(color.aqua, 0), size = size.small, text = "B", force_overlay = true)
plotshape(showFillMarks and justClosed, "賣出成交(主圖)", style = shape.triangledown, location = location.abovebar, color = color.new(color.red, 0),  size = size.small, text = "S", force_overlay = true)

// ─────────────────────────── ⑬ 報表: 交易次數 / 每筆 P&L / Total P&L ───────────────────────────
gRP      = "⑦ 報表"
showRpt  = input.bool(true, "顯示圖上報表", group = gRP)
maxRows  = input.int(25, "最多列出最近幾筆交易", minval = 1, maxval = 60, group = gRP, tooltip = "完整清單見 Strategy Tester → List of Trades (可匯出 CSV)")
rptPos   = input.string("右上", "回測摘要位置 (主圖)", options = ["右下", "右上", "左下", "左上"], group = gRP)
showPrm  = input.bool(true, "副圖顯示「觸發參數」表 (調整用)", group = gRP)
prmPos   = input.string("右上", "觸發參數表位置 (副圖; 預設與主圖摘要同靠右對齊)", options = ["右下", "右上", "左下", "左上"], group = gRP)
txtSize  = input.string("tiny", "字體", options = ["tiny", "small", "normal"], group = gRP)

posV = rptPos == "右下" ? position.bottom_right : rptPos == "右上" ? position.top_right : rptPos == "左下" ? position.bottom_left : position.top_left
sizeV = txtSize == "tiny" ? size.tiny : txtSize == "small" ? size.small : size.normal

var table rpt = table.new(posV, 7, 70, border_width = 1, frame_width = 1, frame_color = color.gray, force_overlay = true)   // 回測摘要 + 逐筆交易 → 主圖
posP = prmPos == "右下" ? position.bottom_right : prmPos == "右上" ? position.top_right : prmPos == "左下" ? position.bottom_left : position.top_left
var table prm = table.new(posP, 2, 12, border_width = 1, frame_width = 1, frame_color = color.gray)   // 觸發參數 → 副圖

// 訊號漏斗計數 (回測窗內 + 盤中): 交叉總數 → 動能合格數, 看門檻濾掉多少
var int cUp = 0
var int cUpOK = 0
var int cDn = 0
var int cDnOK = 0
if inWindow and inSess
    cUp   += crossUp ? 1 : 0
    cUpOK += buySig ? 1 : 0
    cDn   += crossDn ? 1 : 0
    cDnOK += sellSig ? 1 : 0

if barstate.islast and showPrm
    table.clear(prm, 0, 0, 1, 11)
    pBg = color.new(color.gray, 70)
    curOK = curBars >= minBars and curArea >= minArea and curDepth >= minDepth
    table.cell(prm, 0, 0, "觸發參數 (Inputs ④ 調這裡)", text_size = sizeV, text_color = color.white, bgcolor = color.new(color.blue, 40), text_halign = text.align_left)
    table.cell(prm, 1, 0, "", text_size = sizeV, bgcolor = color.new(color.blue, 40))
    table.merge_cells(prm, 0, 0, 1, 0)
    table.cell(prm, 0, 1, "門檻模式 / 係數 k", text_size = sizeV, bgcolor = pBg)
    table.cell(prm, 1, 1, thMode + (thMode != "手動" ? "  k=" + str.tostring(kEff, "#.##") : ""), text_size = sizeV)
    table.cell(prm, 0, 2, "深度門檻 max|hist|/close%", text_size = sizeV, bgcolor = pBg)
    table.cell(prm, 1, 2, str.tostring(minDepth, "#.####") + (thMode != "手動" ? "  (第" + str.tostring(depthPctl, "#") + "百分位 × k)" : ""), text_size = sizeV)
    table.cell(prm, 0, 3, "面積門檻 Σ|hist|/close%", text_size = sizeV, bgcolor = pBg)
    table.cell(prm, 1, 3, str.tostring(minArea, "#.####") + (thMode != "手動" ? "  (深度 × " + str.tostring(minBars) + " × " + str.tostring(areaFactor, "#.##") + ")" : ""), text_size = sizeV)
    table.cell(prm, 0, 4, "最少連續根數", text_size = sizeV, bgcolor = pBg)
    table.cell(prm, 1, 4, str.tostring(minBars) + " 根", text_size = sizeV)
    table.cell(prm, 0, 5, "自動校準 目標/近日均", text_size = sizeV, bgcolor = pBg)
    table.cell(prm, 1, 5, (targetTPD > 0 ? str.tostring(targetTPD, "#") + " 筆/日" : "關閉") + " / " + (na(tpdEMA) ? "-" : str.tostring(tpdEMA, "#.#")), text_size = sizeV)
    table.cell(prm, 0, 6, "現段 (符號·根數·面積·深度)", text_size = sizeV, bgcolor = pBg)
    table.cell(prm, 1, 6, (curSign > 0 ? "正 " : curSign < 0 ? "負 " : "- ") + str.tostring(curBars) + "根 · " + str.tostring(curArea, "#.####") + " · " + str.tostring(curDepth, "#.####") + (curOK ? "  儲夠 ✓" : "  未儲夠"), text_size = sizeV, text_color = curOK ? color.green : color.gray)
    table.cell(prm, 0, 7, "上穿: 全部 → 動能合格 (買訊)", text_size = sizeV, bgcolor = pBg)
    table.cell(prm, 1, 7, str.tostring(cUp) + " → " + str.tostring(cUpOK) + "  (" + str.tostring(cUp > 0 ? cUpOK * 100.0 / cUp : 0.0, "#") + "%)", text_size = sizeV)
    table.cell(prm, 0, 8, "下穿: 全部 → 動能合格 (賣訊)", text_size = sizeV, bgcolor = pBg)
    table.cell(prm, 1, 8, str.tostring(cDn) + " → " + str.tostring(cDnOK) + "  (" + str.tostring(cDn > 0 ? cDnOK * 100.0 / cDn : 0.0, "#") + "%)", text_size = sizeV)
    table.cell(prm, 0, 9, "成交 / 勝率", text_size = sizeV, bgcolor = pBg)
    table.cell(prm, 1, 9, str.tostring(strategy.closedtrades) + " 筆 · " + str.tostring(strategy.closedtrades > 0 ? strategy.wintrades * 100.0 / strategy.closedtrades : 0.0, "#.0") + "%", text_size = sizeV, text_color = color.blue)
    table.cell(prm, 0, 10, "調整方向", text_size = sizeV, bgcolor = pBg)
    table.cell(prm, 1, 10, "要更嚴 (少而準): 百分位↑ 根數↑ 係數↑ 或 目標筆數↓ · 要更鬆: 反之", text_size = sizeV, text_color = color.gray)
    table.cell(prm, 0, 11, "MACD", text_size = sizeV, bgcolor = pBg)
    table.cell(prm, 1, 11, str.tostring(fastLen) + " / " + str.tostring(slowLen) + " / " + str.tostring(sigLen) + " · 1× 柱 (牛牛/Webull 顯示 2×)", text_size = sizeV)

if barstate.islast and showRpt
    table.clear(rpt, 0, 0, 6, 69)
    nT   = strategy.closedtrades
    nW   = strategy.wintrades
    nL   = strategy.losstrades
    net  = strategy.netprofit
    gpr  = strategy.grossprofit
    gls  = strategy.grossloss
    eq0  = strategy.initial_capital
    wr   = nT > 0 ? nW * 100.0 / nT : 0.0      // ※ Pine 整數除法陷阱: nW/nT 兩者皆int會被截斷, 必須先乘 100.0
    pf   = gls != 0 ? gpr / gls : na
    netP = net / eq0 * 100.0
    hdBg = color.new(color.gray, 70)
    // ── 摘要 ──
    for c = 0 to 6
        table.cell(rpt, c, 0, "", text_size = sizeV, bgcolor = color.new(color.blue, 40))
    table.cell(rpt, 0, 0, "回測摘要 · " + str.format_time(btStart, "yyyy-MM-dd", tzStr) + " → " + str.format_time(math.min(btEnd, timenow), "yyyy-MM-dd", tzStr), text_size = sizeV, text_color = color.white, bgcolor = color.new(color.blue, 40), text_halign = text.align_left)
    table.merge_cells(rpt, 0, 0, 6, 0)
    table.cell(rpt, 0, 1, "本金",       text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 1, 1, str.tostring(eq0, "#,###"), text_size = sizeV)
    table.cell(rpt, 2, 1, "交易次數",   text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 3, 1, str.tostring(nT), text_size = sizeV, text_color = color.blue)
    table.cell(rpt, 4, 1, "勝 / 負",    text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 5, 1, str.tostring(nW) + " / " + str.tostring(nL), text_size = sizeV)
    table.cell(rpt, 6, 1, "勝率 " + str.tostring(wr, "#.0") + "%", text_size = sizeV)
    table.cell(rpt, 0, 2, "總損益 $",   text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 1, 2, str.tostring(net, "#,###.##"), text_size = sizeV, text_color = net >= 0 ? color.green : color.red)
    table.cell(rpt, 2, 2, "總損益 %",   text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 3, 2, str.tostring(netP, "#.##") + "%", text_size = sizeV, text_color = net >= 0 ? color.green : color.red)
    table.cell(rpt, 4, 2, "期末權益",   text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 5, 2, str.tostring(eq0 + net, "#,###"), text_size = sizeV)
    table.cell(rpt, 6, 2, "PF " + (na(pf) ? "-" : str.tostring(pf, "#.##")), text_size = sizeV)
    table.cell(rpt, 0, 3, "毛利 / 毛損", text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 1, 3, str.tostring(gpr, "#,###") + " / " + str.tostring(gls, "#,###"), text_size = sizeV)
    table.cell(rpt, 2, 3, "最大回撤(佔本金)", text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 3, 3, str.tostring(strategy.max_drawdown / eq0 * 100.0, "#.##") + "%", text_size = sizeV, text_color = color.red)
    table.cell(rpt, 4, 3, "門檻(現值)", text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 5, 3, "深" + str.tostring(minDepth, "#.###") + " 面" + str.tostring(minArea, "#.##") + " 根" + str.tostring(minBars), text_size = sizeV)
    table.cell(rpt, 6, 3, thMode + (thMode != "手動" and targetTPD > 0 ? " k=" + str.tostring(kEff, "#.##") : ""), text_size = sizeV)
    // ── 盤中專屬列 ──
    tpd = nT * 1.0 / math.max(1, nDays)        // 同上: 先乘 1.0 提升為 float
    table.cell(rpt, 0, 4, "交易日數",   text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 1, 4, str.tostring(nDays), text_size = sizeV)
    table.cell(rpt, 2, 4, "每日均交易", text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 3, 4, str.tostring(tpd, "#.#") + " 次" + (targetTPD > 0 ? " (目標 " + str.tostring(targetTPD, "#") + ")" : ""), text_size = sizeV, text_color = tpd > 12 ? color.red : color.gray)
    table.cell(rpt, 4, 4, "在市場時間", text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 5, 4, str.tostring(barsIn * 100.0 / math.max(1, barsTot), "#.#") + "%", text_size = sizeV, text_color = barsTot == 0 ? color.red : color.gray)
    warnTxt = not tfOK ? "⚠ 非1分鐘週期" : barsTot == 0 ? "⚠ 時段不符!" : not tzMatch ? "⚠ 時區可疑" : "週期/時段 ✓"
    warnCol = (not tfOK or barsTot == 0) ? color.red : not tzMatch ? color.orange : color.green
    table.cell(rpt, 6, 4, warnTxt, text_size = sizeV, text_color = warnCol)
    // ── 逐筆交易表頭 ──
    table.cell(rpt, 0, 5, "#",       text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 1, 5, "進場時間",  text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 2, 5, "出場時間",  text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 3, 5, "進場價",  text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 4, 5, "出場價",  text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 5, 5, "損益 $",  text_size = sizeV, bgcolor = hdBg)
    table.cell(rpt, 6, 5, "損益 %",  text_size = sizeV, bgcolor = hdBg)
    // ── 逐筆交易 (最近 maxRows 筆) ──
    first = math.max(0, nT - maxRows)
    row   = 6
    if nT > 0
        for i = first to nT - 1
            pnl  = strategy.closedtrades.profit(i)
            ep   = strategy.closedtrades.entry_price(i)
            xp   = strategy.closedtrades.exit_price(i)
            pctR = ep != 0 ? (xp / ep - 1.0) * 100.0 : 0.0
            col  = pnl >= 0 ? color.green : color.red
            table.cell(rpt, 0, row, str.tostring(i + 1), text_size = sizeV)
            table.cell(rpt, 1, row, str.format_time(strategy.closedtrades.entry_time(i), "MM-dd HH:mm", tzStr), text_size = sizeV)
            table.cell(rpt, 2, row, str.format_time(strategy.closedtrades.exit_time(i),  "MM-dd HH:mm", tzStr), text_size = sizeV)
            table.cell(rpt, 3, row, str.tostring(ep, format.mintick), text_size = sizeV)
            table.cell(rpt, 4, row, str.tostring(xp, format.mintick), text_size = sizeV)
            table.cell(rpt, 5, row, str.tostring(pnl, "#,###.##"), text_size = sizeV, text_color = col)
            table.cell(rpt, 6, row, str.tostring(pctR, "#.##") + "%", text_size = sizeV, text_color = col)
            row += 1
        if nT > maxRows
            for c = 0 to 6
                table.cell(rpt, c, row, "", text_size = sizeV)
            table.cell(rpt, 0, row, "…僅顯示最近 " + str.tostring(maxRows) + " 筆, 共 " + str.tostring(nT) + " 筆; 完整清單見 Strategy Tester → List of Trades", text_size = sizeV, text_color = color.gray, text_halign = text.align_left)
            table.merge_cells(rpt, 0, row, 6, row)
    else
        for c = 0 to 6
            table.cell(rpt, c, row, "", text_size = sizeV)
        noTradeMsg = barsTot == 0 ? "⚠ 期內無交易 —【時段設定與此商品不符】策略用 " + tzStr + " " + sessStr + ", 但 " + syminfo.ticker + " 的交易所時區是 " + syminfo.timezone + " → 請到 ⑤ 盤中時段 把「市場預設」改對 (港股/美股)" : "期內無交易 — 先確認 strategy() 仍有 margin_long = 0 (v6 預設 100% 會令全部本金下單被拒); 再調 ④ 目標每日交易次數 / 門檻, 或拉長 ① 期間"
        table.cell(rpt, 0, row, noTradeMsg, text_size = sizeV, text_color = color.orange, text_halign = text.align_left)
        table.merge_cells(rpt, 0, row, 6, row)

// ─────────────────────────── ⑭ 收盤把報表也輸出到 Pine Logs (方便複製) ───────────────────────────
if barstate.islastconfirmedhistory and showRpt
    log.info("===== MACD動能回測 {0} · {1} → {2} =====", syminfo.ticker, str.format_time(btStart, "yyyy-MM-dd", tzStr), str.format_time(btEnd, "yyyy-MM-dd", tzStr))
    log.info("交易次數 {0} · 勝 {1} 負 {2} · 總損益 {3} ({4}%) · 本金 {5} · 門檻係數 k={6} · 現門檻 深{7} 面{8} 根{9}", strategy.closedtrades, strategy.wintrades, strategy.losstrades, str.tostring(strategy.netprofit, "#,###.##"), str.tostring(strategy.netprofit / strategy.initial_capital * 100.0, "#.##"), str.tostring(strategy.initial_capital, "#,###"), str.tostring(kEff, "#.##"), str.tostring(minDepth, "#.####"), str.tostring(minArea, "#.####"), minBars)
    if strategy.closedtrades > 0
        for i = 0 to strategy.closedtrades - 1
            log.info("#{0} {1} → {2} | {3} → {4} | P&L {5} ({6}%)", i + 1, str.format_time(strategy.closedtrades.entry_time(i), "yyyy-MM-dd HH:mm", tzStr), str.format_time(strategy.closedtrades.exit_time(i),  "yyyy-MM-dd HH:mm", tzStr), str.tostring(strategy.closedtrades.entry_price(i), format.mintick), str.tostring(strategy.closedtrades.exit_price(i),  format.mintick), str.tostring(strategy.closedtrades.profit(i), "#,###.##"), str.tostring((strategy.closedtrades.exit_price(i) / strategy.closedtrades.entry_price(i) - 1.0) * 100.0, "#.##"))
// ═══ END OF FILE ═══ TW-1M-MACD-(09月19日_18:14) · 全檔共 395 行 · 看不到這一行 = 貼上的內容被截斷, 請用「貼上工具」網頁的【複製全部程式碼】 ═══
